    $('#DonationDestinationSubOfSubReceptionId').change(function (e) {
        var code = this.options[this.selectedIndex].getAttribute('Code');
        if (code == "DonGeneralCase") {
            $('#ReceptionDonationCaseCodeContainer').show();
            $("#ReceptionDonationCaseCode").rules("add", {
                required: true,
