                            </div>
                        </div>
                        <div class="row" style="display: none;">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="inline col-md-12" style="width: 100%, float: @(CultureHelper.IsRighToLeft() ? "right" : "left")">
                                        @Html.CheckBoxFor(model => model.IsActiveDirectoryUser, new { @class = "ace col-md-1", @Id = "chbIsActiveDirectoryUser" })
                                        <span style="@(CultureHelper.IsRighToLeft() ? "margin-right:9px;" : "margin-left:9px;")">@UserManagementResources.IsActiveDirectoryUser</span>
                                    </label>
                                    @Html.ValidationMessageFor(model => model.IsActiveDirectoryUser)

                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="inline col-md-12" style="width: 100%, float: @(CultureHelper.IsRighToLeft() ? "right" : "left")">
                                        @Html.CheckBoxFor(model => model.IsActiveUser, new { @class = "ace col-md-1" })
                                        <span style="@(CultureHelper.IsRighToLeft() ? "margin-right:9px;" : "margin-left:9px;")">@UserManagementResources.IsActiveUser</span>
