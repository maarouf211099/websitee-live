@using Resource
@model UserUI.Models.RepresentativeDonationViewModelAnonymous
<div id="RepresentativeDonationTabs" class="donation-fields pt-2">
    <div class="tabContainer">
        <strong class="popup-title text-center pt-3">
            @DonationResources.RepresentativeDonationDescription

        </strong>
        @*<strong class="popup-title">@DonationResources.PERSONALDETAILS</strong>*@
        @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "RepresentativeDonationForm" }))
        {
    <div class="form">

        <input type="hidden" class="hidAccountIdDonation" name="AccountId" />
        <input type="hidden" class="hidCaseIdDonation" name="CaseId" />
        <input type="hidden" class="hidDonationType" name="DonationType" />


        <div class="col-md-6 FloatRight">
            <div class="textfield">
                @Html.TextBoxFor(x => x.NameAnonymous, new { @class = "form-control  textfield", placeholder = @DonationResources.DonationName + '*' })
                @Html.ValidationMessageFor(x => x.NameAnonymous)
            </div>
        </div>
        <div class="col-md-6 FloatRight">
            <div class="textfield">
                @Html.TextBoxFor(x => x.PhoneNumberAnonymous, new { @class = "form-control textfield", placeholder = @DonationResources.Phone + '*' })
                @Html.ValidationMessageFor(x => x.PhoneNumberAnonymous)
            </div>
        </div>
        <div class="col-md-6 FloatRight">
            <div class="textfield">
                @Html.TextBoxFor(x => x.AddressAnonymous, new { @class = "form-control textfield", placeholder = @DonationResources.Address + '*' })
                @Html.ValidationMessageFor(x => x.AddressAnonymous)
            </div>
        </div>
        <div class="col-md-6 FloatRight">
            <div class="textfield">
                @Html.TextBoxFor(x => x.EmailAnonymous, new { placeholder = @DonationResources.Email + '*' })
                @Html.ValidationMessageFor(x => x.EmailAnonymous)
            </div>
        </div>

        <div class="col-md-6">
            <div class="textfield">
                @Html.TextBoxFor(x => x.Amount, new { Value = "", placeholder = DonationResources.EnterTheAmountYouWant+'*', onkeypress = "return event.charCode >= 48 && event.charCode <= 57" })
                @Html.ValidationMessageFor(x => x.Amount)
            </div>
        </div>
        @*<div class="form-group col-md-12 DonationDestinationTypeDiv" style="display:none;">
            <label class="col-md-4 control-label FloatRight">@DonationResources.DonationDestination :</label>
            <div class="col-sm-8">
                @Html.DropDownListFor(x => x.DonationDestinationId, new List<SelectListItem>(), new { @class = "form-control" })
            </div>
        </div>*@
