@model DTO.AlbumsDTO
@using Resource
@using DTO
@using UserUI.Helper
@using Kendo.Mvc.UI
@{
    bool isArabic = UserUI.Helper.CultureHelper.GetCurrentCulture() == "ar-SA";
    var KendoClass = isArabic ? "k-rtl" : "";

}
<div class="modal fade" id="AlbumDetailsModals" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-body">
            <div class="box box-info">
                <div class="box-header with-border">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    @*<h4 class="modal-title">@AlbumResource.EditAlbum</h4>*@
                </div>
                <div class="box-body">
                    @using (Html.BeginForm(null, null, null, FormMethod.Post, new { @class = "", id = "EditAlbumForm" }))
                    {
                        @Html.HiddenFor(m => m.Id)
                        @Html.HiddenFor(m => m.ImagePath)
                        @Html.HiddenFor(m => m.AlbumId)
                        <div class="form-horizontal">
                            <div class="form-group">
                                @Html.LabelFor(model => model.TitleEn, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.TextBoxFor(model => model.TitleEn, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.TitleEn)
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.TitleAr, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.TextBoxFor(model => model.TitleAr, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.TitleAr)
                                </div>
                            </div>



                            <div class="form-group">
                                <div class="col-md-8">
                                    <img src="@Model.ImagePath" style="max-width:150px;" />
                                </div>
                            </div>
                            <div class="demo-section k-content @KendoClass ">
                                @(Html.Kendo().Upload()
                                    .Name("Image")
                                     .Messages(m => m.Select(HomeSliderResources.ImagePath).UploadSelectedFiles(LayoutRES.Submit))
                                    .TemplateId("fileTemplate")
                                    .HtmlAttributes(new { accept = "image/*", id = "EditImageAlbum" })
                                    .Multiple(false)
                                    .Async(a => a
                                    .Save("EditAlbum", "Album")
                                    .AutoUpload(false))
                                    .Events(c => c
                                    .Upload("onUploadAlbumImageEdit").Success("onSuccessUploadDataEdit")
                                    .Select("onSelectImage")
                                    )
                                )
                            </div>
                            <input type="hidden" value="false" name="isImageChanged" />
                            <div class="form-group">
                                <div class="col-md-offset-2 col-md-8">
                                    @*<input id="btnSubmitEdit" onclick="submitEditSlide()" type="button" value="@LayoutRES.Submit" class="btn btn-default" />*@
                                    <input id="btnSubmitEdit" onclick="submitEditSlide()" type="button" value="@LayoutRES.Submit" class="btn btn-info" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
               
            </div>
        </div>
    </div>
</div>