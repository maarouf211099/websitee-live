@model DTO.ActivityDTO
@using Kendo.Mvc.UI
@using Resource

@{
    ViewBag.Title = ActivitiesRES.EditActivity;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    DTO.ActivityDTO activity = ViewBag.Data;
    bool isArabic = UserUI.Helper.CultureHelper.GetCurrentCulture() == "ar-SA";
    var schedulerClass = isArabic ? "k-rtl" : "";
    var dir = isArabic ? "rtl" : "ltr";
    var mersalapi = ViewBag.mersalApi;
    var KendoClass = isArabic ? "k-rtl" : "";
}

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "EditForm" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.Id, new { Value = activity.Id })
    <div class="form-horizontal" dir="@dir">
        <hr />
        @Html.ValidationSummary(true)
        
        <div class="form-group">

            @Html.LabelFor(model => model.Title, new { @class = "col-md-2  control-label"})
            <div class="col-md-3">
                @Html.TextBoxFor(model => model.Title, new { @class = "form-control", Value=activity.Title })
                @Html.ValidationMessageFor(model => model.Title)
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-3">
                @Html.TextAreaFor(model => model.Description, new { @class = "form-control", @Text="test" })
                @Html.ValidationMessageFor(model => model.Description)
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Address, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-3">
                @Html.TextBoxFor(model => model.Address, new { @class = "form-control", Value=activity.Address })
                @Html.ValidationMessageFor(model => model.Address)
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.MaxCapacity, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-3">
                @Html.Kendo().NumericTextBoxFor(model => model.MaxCapacity).Min(0).Format("0").Value(activity.MaxCapacity)
                @Html.ValidationMessageFor(model => model.MaxCapacity)
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.IsFree, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-3">
                @Html.Kendo().CheckBoxFor(model => model.IsFree).Checked(activity.IsFree)
                @Html.ValidationMessageFor(model => model.IsFree)
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Fees, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-3">
                @Html.Kendo().NumericTextBoxFor(model => model.Fees).Format("0.00").Min(0).Value(activity.Fees).Enable(!activity.IsFree)
                @Html.ValidationMessageFor(model => model.Fees)
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-3">
                @Html.Kendo().CheckBoxFor(model => model.IsActive).Checked(activity.IsActive)
                @Html.ValidationMessageFor(model => model.IsActive)
            </div>
        </div>

        @*<div class="form-group">
            @Html.Label(ActivitiesRES.PublicAcademia, new { @class = "control-label col-md-2" })
            <div id="IsAcademia" class="col-md-8">
                <div class="col-md-6" floatToRight style="align-items:center">
                    <div class="col-md-2">
                        <input type="radio" name="IsAcademia" id="isPubhlicAcademia" @(Model.IsAcademia == true ? "checked" : "") value=false style="width:25px;height:25px;margin:0!important" />
