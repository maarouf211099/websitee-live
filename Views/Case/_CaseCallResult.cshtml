
@model DTO.CaseCallResultDTO
@using System.Globalization;
@using Resource
@using DTO
@using UserUI.Helper

<div class="modal fade" id="CaseCallResultModals" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-body">
            <div class="box box-info">
                <div class="box-header with-border">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">@CaseResources.CallResult</h4>
                </div><!-- /.box-header -->
                <!-- form start -->
                <div class="box-body AccordionDiv">
                    @if (Model.CaseCallResultDTOList != null)
                    {
                        if (Model.CaseCallResultDTOList.Any())
                        {
                            foreach (var call in Model.CaseCallResultDTOList)
                            {
                                <h3>
                                    @call.UserName  - @call.CreatedOn.ToString("d/M/yyyy HH:mm", CultureInfo.InvariantCulture)
                                </h3>
                                <div>@call.CallResult</div>
                            }
                        }
                    } 
                    @if (AuthorizationHelper.UserIsInPrivilege((int)EnumPrivilages.AddComment_FileToCase))
                    {
                        using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form-horizontal", id = "AddCaseCallResultForm" }))
                        {
                            @Html.HiddenFor(x => x.CaseId)
                    <!-- /.box-body -->
                            <div class="box-footer">
                                <div class="form-group">
                                    <div class="col-sm-12">
                                        @Html.TextBoxFor(m => m.CallResult, "", new { @class = "form-control", placeholder = Html.DisplayNameFor(m => m.CallResult) })
                                        @Html.ValidationMessageFor(m => m.CallResult)
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-info pull-right">@CaseResources.CallResult</button>
                                <button type="button" class="btn btn-default pull-left" data-dismiss="modal">@LayoutRES.Close</button>
                            </div><!-- /.box-footer -->
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $(".AccordionDiv").accordion({
            collapsible: true,
            active: true,
            header: "h3",
            heightStyle: "content",
        });
    });
</script>

