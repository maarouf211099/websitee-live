@functions {
object getHtmlAttributes(bool? ReadOnly, string CssClass, string type = "", string placeHolder = "")
{
    if (ReadOnly != null && ReadOnly == true)
    {
        return new { type = type, @class = CssClass, @readonly = "readonly", placeholder = placeHolder };
    }
    return new { type = type, @class = CssClass, placeholder = placeHolder };
}
}
