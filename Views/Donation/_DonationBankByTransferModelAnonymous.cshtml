    $('#DonationDestinationIdd').change(function () {

        $('#DonationSubb').hide();
        $('#DonationSubOfSubb').hide();
        $('#DonationByBankCaseCodeContainer').hide();

        $('#DonationDestinationSubOfSubIdd').html('');
        $('#DonationDestinationSubIdd').html('');

        $("#DonationDestinationSubIdd").rules("add", {
            required: false,
            messages: {
                required: requiredDonationDestination
            }
        });

        $("#DonationDestinationSubOfSubIdd").rules("add", {
            required: false,
            messages: {
                required: requiredDonationDestination
            }
        });

        $("#DonationByBankCaseCode").rules("add", {
            required: false,
            messages: {
                required: requiredCaseCode
            }
        });


        var id = $('#DonationDestinationIdd').val();
        var placeHolder = _cultureIsArabic ? 'مخصص الى' : 'Dedicated to';
        GetByParentIdBankTransfer('DonationDestinationSubIdd', id, 'DonationSubb', placeHolder);
    });

    $('#DonationDestinationSubIdd').change(function () {
        $('#DonationSubOfSub').hide();
        $('#DonationDestinationSubOfSubIdd').html('');

        $("#DonationDestinationSubOfSubIdd").rules("add", {
            required: false,
            messages: {
                required: requiredDonationDestination
            }
        });

        var code = this.options[this.selectedIndex].getAttribute('Code');
        if (code == "DonZkaCase") {
            $('#DonationByBankCaseCodeContainer').show();
            $("#DonationByBankCaseCode").rules("add", {
                required: true,
                messages: {
                    required: requiredCaseCode
                }
            });
        }
        else {
            $('#DonationByBankCaseCodeContainer').hide();
            $('#DonationByBankCaseCode').val('');
            $("#DonationByBankCaseCode").rules("add", {
                required: false,
                messages: {
                    required: requiredCaseCode
                }
            });
            var id = $('#DonationDestinationSubIdd').val();
            var placeHolder = _cultureIsArabic ? 'مخصص الى' : 'Dedicated to';
            GetByParentIdBankTransfer('DonationDestinationSubOfSubIdd', id, 'DonationSubOfSubb', placeHolder);
        }
    });

    $('#DonationDestinationSubOfSubIdd').change(function (e) {
        var code = this.options[this.selectedIndex].getAttribute('Code');
        if (code == "DonGeneralCase") {
            $('#DonationByBankCaseCodeContainer').show();
            $("#DonationByBankCaseCode").rules("add", {
                required: true,
                messages: {
                    required: requiredCaseCode
                }
            });
        }
        else {
            $('#DonationByBankCaseCodeContainer').hide();
            $('#DonationByBankCaseCode').val('');
            $("#DonationByBankCaseCode").rules("add", {
                required: false,
                messages: {
                    required: requiredCaseCode
                }
            });
        }
    });


    $('#BankId').change(function () {
        $('#AccountBank').hide();
        $('#DonationAccountId').html('');

        $("#DonationAccountId").rules("add", {
            required: true,
            messages: {
                required: requiredDonationDestination
            }
        });


        var id = $('#BankId').val();
        GetAccountBankByParentId('DonationAccountId', id, 'AccountBank', '@DonationResources.BankAccount');
        //$("#DonationAccountId").required = true;


    });


    $('#DonationAccountId').change(function () {
        $('#DonationCurrency').hide();
        $('#DonationCurrencyId').html('');

        $("#DonationCurrencyId").rules("add", {
            required: false,
            messages: {
                required: requiredDonationDestination
            }
        });


        var id = $('#DonationAccountId').val();
        GetAllDonationCurencyByAccountId('DonationCurrencyId', id, 'DonationCurrency','@DonationResources.Currency');
    });







    function GetAnyMasterDetalisCode(MasterCode, dropDownListId, enableAll, async, selectedId, PerantCode, emptyOption ,placeholder) {
        $.ajax({
            type: "GET",
            contentType: "application/json",
            url: SystmeCodeWebAPIBaseUrl + "api/DetailCode/GetMasterCodeByMultiCode?masterCode=" + MasterCode,
            async: async,
            success: function (data) {
                var html = "";
                if (enableAll) {
                    if (_cultureIsArabic) {
                        html = "<option value='0'>الكل</option>";
                    }
                    else {
                        html = "<option value='0'>All</option>";
                    }
                }
                if (PerantCode) {
                    $.each(data, function (key, value) {
                        if (value.Parent) {
                            if (value.Parent.Code == PerantCode) {
                                var selec = "";
                                if (value.masterCodeValue == MasterCode) {
                                    if (value.Id == selectedId) selec = " selected='selected' ";
                                    if (_cultureIsArabic) {
                                        html += "<option Code=\"" + value.Code + "\" value=" + value.Id + selec + "  >" + value.NameAr + "</option>";
                                    }
                                    else {
                                        html += "<option Code=\"" + value.Code + "\" value=" + value.Id + selec + " >" + value.NameEn + "</option>";
                                    }
                                }
                            }
                        }
                    });
                }
                else {
                    $.each(data, function (key, value) {
                        var selec = "";
                        if (value.masterCodeValue == MasterCode) {
                            if (value.Id == selectedId) selec = " selected='selected' ";
                            if (_cultureIsArabic) {
                                html += "<option Code=\"" + value.Code + "\" value=" + value.Id + selec + "  >" + value.NameAr + "</option>";
                            }
                            else {
                                html += "<option Code=\"" + value.Code + "\" value=" + value.Id + selec + " >" + value.NameEn + "</option>";
                            }
                        }
                    });
                }
                $("#" + dropDownListId).html(html);
                if (emptyOption) {
                    $("#" + dropDownListId).prepend("<option value='' selected='selected'>" + placeholder +'*'+"</option>");
                }
            },
            error: function (xhr) {
                toastr.error(xhr.statusText);
            }
        });


    }



    function GetByParentIdBankTransfer(dropDownId, parentId, itemToShow, placeHolder= '') {
        var url = SystmeCodeWebAPIBaseUrl + "api/DetailCode/GetByParentId?parentId=" + parentId;
        $.ajax({
            type: "GET",
            contentType: "application/json",
            url: url,
            async: true,
            success: function (data) {
                var htmlGovernorate = "<option value=''>" + placeHolder + "</option>";
                $.each(data, function (key, value) {
                    htmlGovernorate += "<option Code=\"" + value.Code + "\" value=" + value.Id + " >" + value.NameEn + "</option>";
                });
                $("#" + dropDownId).html(htmlGovernorate);
                if (data.length != 0) {
                    $('#' + itemToShow).show();
                    $("#" + dropDownId).rules("add", {
                        required: true,
                        messages: {
                            required: requiredDonationDestination
                        }
                    });
                }
            },
            error: function (xhr) {
                //toastr.error(xhr.statusText);
            }
        });

    }




    // bank


