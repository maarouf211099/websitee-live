
@model DTO.AddMasterAfiaDTO
@using Resource
@using Resource.Pharmacy
@using UserUI.Helper
@using Kendo.Mvc.UI

@{
    bool isArabic = UserUI.Helper.CultureHelper.GetCurrentCulture() == "ar-SA";
    var floatToRight = (CultureHelper.IsRighToLeft() ? "floatToRight" : "");
    var textAlignRight = isArabic ? "text-align: right;" : "";
    var dir = isArabic ? "rtl" : "ltr";
    var KendoClass = isArabic ? "k-rtl" : "";
}


<div class="modal fade" id="AddMasterAfiaModals" role="dialog" dir="@dir">
    <div class="modal-dialog" style="width: 900px;">
        <!-- Modal content-->
        <div class="modal-body">
            <div class="box box-info">
                <div class="box-header with-border">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">@Resource.Afia.MasterAfiaRES.AddNewMasterAfia</h4>
                </div><!-- /.box-header -->
                <!-- form start -->
                @using (Html.BeginForm("Create", "MasterAfia", null, FormMethod.Post, new { @class = "form-horizontal", id = "AddMasterAfiaForm" }))
                {
                    @Html.HiddenFor(model => model.Id)

                    <div class="box-body">
                        <label>@Resource.Afia.MasterAfiaRES.nameAr</label>
                        @Html.TextBoxFor(m => m.NameAr, new { @class = "form-control", placeholder = @Resource.Afia.MasterAfiaRES.nameAr })
                        @Html.ValidationMessageFor(m => m.NameAr)
                        <br />

                        <label>@Resource.Afia.MasterAfiaRES.nameEn</label>
                        @Html.TextBoxFor(m => m.NameEn, new { @class = "form-control", placeholder = @Resource.Afia.MasterAfiaRES.nameAr })
                        @Html.ValidationMessageFor(m => m.NameEn)


                        <br />
                        <label>@Resource.Afia.MasterAfiaRES.DescrptionAr</label>

                        @Html.TextAreaFor(m => m.DescriptionAr, new { style = textAlignRight, @class = "form-control", placeholder = @Resource.Afia.MasterAfiaRES.DescrptionAr })
                        @Html.ValidationMessageFor(m => m.DescriptionAr)
                        <br />
                        <label>@Resource.Afia.MasterAfiaRES.descriptionEn</label>

                        @Html.TextAreaFor(m => m.DescriptionEn, new { style = textAlignRight, @class = "form-control", placeholder = @Resource.Afia.MasterAfiaRES.descriptionEn })
                        @Html.ValidationMessageFor(m => m.DescriptionEn)
                        <br />
                        <label>@Resource.Afia.MasterAfiaRES.Icon</label>
                        @if(!String.IsNullOrEmpty(Model.Icon))
                {

                            <img src=@Model.Icon></img>
                }
                        <div class="demo-section k-content @KendoClass ">
                            @(Html.Kendo().Upload()
            .Name("Image")
             .Messages(m => m.Select(AlbumResource.Image).UploadSelectedFiles(LayoutRES.Submit))
            .TemplateId("fileTemplate")
            .HtmlAttributes(new { accept = "image/*" })
            .Multiple(false)
            .Async(a => a
            .Save("CreateAlbum", "MasterAfia")
            .AutoUpload(false))
            .Events(c => c
            .Upload("onUploadAlbumImageCreate").Success("onSuccessUploadDataCreate"))
        )
                            @*@Html.TextAreaFor(m => m.Icon, new { style = textAlignRight, @class = "form-control", placeholder = @Resource.Afia.MasterAfiaRES.Icon })*@

                            @Html.ValidationMessageFor(m => m.Icon)
                        </div>
                        <br />
                        <label>@Resource.Afia.MasterAfiaRES.IsActive</label>
                        <br />

                        @Html.CheckBoxFor(m => m.IsActive, new { Id = "IsActive" })
                        @Html.ValidationMessageFor(m => m.IsActive)
                        <br />



                    </div>

                    <!-- /.box-body -->
                    <div class="box-footer">
                        <button type="submit" class="btn btn-info">@LayoutRES.Submit</button>
                        <button type="button" class="btn btn-default" data-dismiss="modal">@LayoutRES.Close</button>
                    </div><!-- /.box-footer -->
                }
            </div>
        </div>
    </div>
</div>

<script>

    var Icon= @Html.Raw(Json.Encode(Model.Icon))
</script>