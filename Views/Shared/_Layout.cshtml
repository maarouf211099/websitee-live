    <script>

        var CIBTransactionsLoggingDetailsUrl = "../Logger/PostLoggerInformation"
        let donationInfo = JSON.parse(localStorage.getItem("confirmDonationData"));
        let details = donationInfo != null ? donationInfo.details : null;
        var data;

        function errorCallback(error) {
            data = {
                logType: "CIBTransactionsLogger",
                state: 'error',
                message: 'Error In Transaction',
                details: error,
                status: (donationInfo || {}).status,
                amount: (details || {}).Amount,
                currency: (details || {}).Currency,
                email: (details || {}).DonatorEmail,
                merchant: (details || {}).Merchant,
                orderInfo: (details || {}).OrderInfo,
                txnResponseCode: (details || {}).TxnResponseCode,
                donationId: (donationInfo || {}).donationId,
                referenceNumber: (details || {}).referenceNumber
            }
            cibTransactionLog(data);
            toastr.error(error);
        }

        function cancelCallback() {
            data = {
                logType: "CIBTransactionsLogger",
                state: 'cancel',
                message: 'Donation Canceled',
                status: (donationInfo || {}).status,
                amount: (details || {}).Amount,
                currency: (details || {}).Currency,
                email: (details || {}).DonatorEmail,
                merchant: (details || {}).Merchant,
                orderInfo: (details || {}).OrderInfo,
                txnResponseCode: (details || {}).TxnResponseCode,
                donationId: (donationInfo || {}).donationId,
                referenceNumber: (details || {}).referenceNumber

            }
            cibTransactionLog(data);
            toastr.info('Donation Canceled');
        }
        //function completeCallback(response) {
        // console.log("completeCallback", response);
        // Save the resultIndicator
        // resultIndicator = response;
        //  var result = (resultIndicator === successIndicator) ? "SUCCESS" : "ERROR";

        //  window.location.href = "/hostedCheckout/" + 1 + "/" + 1;
        //}
        function completeCallback(resultIndicator, sessionVersion) {
            //handle payment completion
            //donationInfo.status = 6800;



            //data = {
            //    logType: "CIBTransactionsLogger",
            //    state: 'complete',
            //    message: 'Donation Completed Succesfully',
            //    resultIndicator,
            //    sessionVersion,
            //    status: donationInfo.status,
            //    amount: details.Amount,
            //    currency: details.Currency,
            //    email: details.DonatorEmail,
            //    merchant: details.Merchant,
            //    orderInfo: details.OrderInfo,
            //    txnResponseCode: details.TxnResponseCode,
            //    donationId: donationInfo.donationId,
            //    referenceNumber: details.referenceNumber
            //}

            //cibTransactionLog(data);
            //getReceipt(donationInfo);

            let donationInfo = hcoLoadDonation();
            if (!donationInfo) {
                console.log("HCO: donation data not found");
                return;
            }
            if (donationInfo.successIndicator && resultIndicator && resultIndicator !== donationInfo.successIndicator) {
                console.log("HCO: resultIndicator mismatch");
                toastr.error("لم تكتمل عملية الدفع");
                return;
            }
            donationInfo.status = 6800;

            getReceipt(donationInfo);


        }

        //function confirmDonation(data) {
        //    var json = JSON.stringify(data);
        //    $.ajax({
        //        cashe: false,
        //        url: "http://localhost:22782/MersalAPI/api/Donation/ConfirmOnlineDonation",
        //        type: "POST",
        //        data: json,
        //        contentType: "application/json",
        //        success: function (result) {
        //            toastr.success('Donation completed');
        //        },
        //        error: function (error) {
        //            toastr.error(error);
        //        }

        //    });
        //}

        // HCO v100: donation data survives the redirect to the bank (localStorage, or cookie if www/non-www differs)
        function hcoLoadDonation() {
            try { var s = localStorage.getItem("confirmDonationData"); if (s) return JSON.parse(s); } catch (e) { }
            var m = document.cookie.match(/(?:^|;\s*)confirmDonationData=([^;]*)/);
            if (m) { try { return JSON.parse(decodeURIComponent(m[1])); } catch (e) { } }
            return null;
        }

        // HCO v100: the bank redirects back to interaction.returnUrl (?hcoReturn=1&resultIndicator=...&sessionVersion=...)
        window.addEventListener("load", function () {
            var q = new URLSearchParams(window.location.search);
            if (q.get("hcoReturn") === "1" && q.get("resultIndicator")) {
                var ri = q.get("resultIndicator"), sv = q.get("sessionVersion");
                if (window.history && history.replaceState) history.replaceState(null, "", window.location.pathname);
                completeCallback(ri, sv);
            }
        });

        function getReceipt(data) {
            var json = JSON.stringify(data.details);
            $.ajax({
                cashe: false,
                url: "../OnlineDonation/GetReceipt",
                type: "POST",
                data: json,
                contentType: "application/json",
                headers: getHeaders(),
                success: function (result) {
                    window.location.href = result.Url;
                },
                error: function (error) {
                    console.log(error);
                }

            });
        }

        function cibTransactionLog(data) {
            $.ajax({
                url: CIBTransactionsLoggingDetailsUrl,
                type: "POST",
                dataType: "text",
                cache: false,
                data: data
            })
        }

    </script>

