@section Scripts {
    <script>
            //resourses
            var Free = '@ActivitiesRES.Free';
            var IsAcademia = '@ActivitiesRES.IsAcademia';
            var IsPublic = '@ActivitiesRES.IsPublic';
            var ShowDeleted = '@ActivitiesRES.ShowDeleted';
            var ShowAll = '@ActivitiesRES.ShowAll';
    </script>
