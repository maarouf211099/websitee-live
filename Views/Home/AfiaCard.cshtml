@using Resource
@using UserUI.Helper


<section class="section mt-3 mb-3">
    <div class="container">
        <div class="content-sector">

            <div class="row align-items-center">
                <div class="col-md-4">
                    <div class="box-info-card">
                        <h2>
                            @Resource.Afia.MasterAfiaRES.AfiaCard
                        </h2>
                        <h5> @Resource.Afia.MasterAfiaRES.Afiaheder1</h5>
                        <p> @Resource.Afia.MasterAfiaRES.Afiaparg1</p>


                    </div>
                </div>
                <div class="col-md-8 text-center">
                    <img src="~/images/card-Mockup.png">
                </div>
            </div>

        </div>
    </div>
</section>
<section class="section-feature">
    <div id="DonationCalculator" class="container">
        <div class="content-sector">

            <div class="row align-items-center">
                <div class="col-md-6">
                    <img src="~/images/img-01.png" width="100%">
                </div>
                <div class="col-md-6">
                    <div class="box-info-card">

                        <h2> @Resource.Afia.MasterAfiaRES.Afiaheder2</h2>

                        <ul>
                            <li><img class="img-icon" src="https://mersal-ngo.org/ClientFilesLayout/DynamicPageImages/checklist.png">@Resource.Afia.MasterAfiaRES.Afialist1</li>
                            <li><img class="img-icon" src="https://mersal-ngo.org/ClientFilesLayout/DynamicPageImages/checklist.png">@Resource.Afia.MasterAfiaRES.Afialist2</li>
                            <li><img class="img-icon" src="https://mersal-ngo.org/ClientFilesLayout/DynamicPageImages/checklist.png">@Resource.Afia.MasterAfiaRES.Afialist3</li>
                            <li><img class="img-icon" src="https://mersal-ngo.org/ClientFilesLayout/DynamicPageImages/checklist.png">@Resource.Afia.MasterAfiaRES.Afialist4</li>
                            <li><img class="img-icon" src="https://mersal-ngo.org/ClientFilesLayout/DynamicPageImages/checklist.png">@Resource.Afia.MasterAfiaRES.Afialist5</li>
                            <li><img class="img-icon" src="https://mersal-ngo.org/ClientFilesLayout/DynamicPageImages/checklist.png">@Resource.Afia.MasterAfiaRES.Afialist6</li>
                        </ul>

                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="sectors">
    <div class="container">
        <div class="content-sector">

            <div class=" align-items-center">
                @if (!CultureHelper.IsRighToLeft())
                {
                        <div class="row">
                            <h2 class="box-info-card"> @Resource.Afia.MasterAfiaRES.AfiaServices </h2>
                        </div>
                    <div class="col-md-8">
                        <div class="row   MasterAfia">

                        </div>
                    </div>
                    <div class="col-md-4">
                        <img src="~/images/img-02-en.png" class="sectors-img">
                    </div>
                }

                @if (CultureHelper.IsRighToLeft())
                {
                        <div class="row">
                            <h2 class="box-info-card"> @Resource.Afia.MasterAfiaRES.AfiaServices </h2>
                        </div>
                    <div class="col-md-4">
                        <img src="~/images/img-02.png" class="sectors-img">
                    </div>
                    <div class="col-md-8">
                        <div class="row col-md-12  MasterAfia">

                        </div>
                    </div>
                }
            </div>
        </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4" crossorigin="anonymous"></script>
<script src="~/Scripts/AfiaScripts/AfiaCard/AfiaCard.js"></script>
<script>
    $(document).ready(function () {

        getMasterAfia();
    });
</script>
