@using DTO
@using Kendo.Mvc.UI
@using UserUI.Helper
@using Resource;
@using System.Configuration
@{
    //ViewBag.Title = ActivitiesRES.CreateActivity;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    bool isArabic = UserUI.Helper.CultureHelper.GetCurrentCulture() == "ar-SA";
    var schedulerClass = isArabic ? "k-rtl" : "";
    var dir = isArabic ? "rtl" : "ltr";
    var mersalapi = ViewBag.mersalApi;
    var local = Server.MapPath("~").Replace("/", "\\");
}
<input type="hidden" value="@ViewBag.ActId" name="ActivityId" id="ActivityId" />

<div>
    <div class="box">
        <div class="box-header">
            <div class="box-body table-responsive no-padding">
                <table class="table table-hover">
                    <th style="text-align: right">
                        <label>@ActivitiesRES.Count @ActivitiesRES.Participants : </label>
                        <label class="label label-success" id="lblCountMembers"> </label>
                    </th>
                    <th style="text-align: right">
                        <label>@ActivitiesRES.ValueAmount : </label>
                        <label class="label label-success" id="lblActivityValueAmount"> </label>
                    </th> 
                </table>
            </div><!-- /.box-body -->
        </div><!-- /.box -->
    </div>
</div>

