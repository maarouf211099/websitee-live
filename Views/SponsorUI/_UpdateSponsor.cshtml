



@model DTO.SponsorsDTO
@using Resource
@using DTO
@using UserUI.Helper
@using Kendo.Mvc.UI
@{
    bool isArabic = UserUI.Helper.CultureHelper.GetCurrentCulture() == "ar-SA";
    var KendoClass = isArabic ? "k-rtl" : "";
}

<div class="modal fade" id="EditSponsorModals" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-body">
            <div class="box box-info">
                <div class="box-header with-border">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    @*<h4 class="modal-title">@LayoutRES.EditSponsor</h4>*@
                    <h4 class="modal-title">@LayoutRES.EditSponsor</h4>
                </div>
                <div class="box-body">
                    @using (Html.BeginForm(null, null, null, FormMethod.Post, new { @class = "", id = "EditSponsorForm" }))
                    {
                        @Html.HiddenFor(m => m.Id)
                        @Html.HiddenFor(m => m.ImageName)
                        <div class="form-horizontal">
                            <div class="form-group">
                                @Html.LabelFor(model => model.href, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.TextBoxFor(model => model.href, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.href)
                                </div>
                            </div> 
                            <div class="form-group">
                                <div class="col-md-8">
                                    <img src="@Model.ImagePath " style="max-width:150px;" />
                                </div>
                            </div>
                            <div class="demo-section k-content @KendoClass ">
                                @(Html.Kendo().Upload()
                                    .Name("Image")
                                     .Messages(m => m.Select(HomeSliderResources.ImagePath).UploadSelectedFiles(LayoutRES.Submit))
                                    .TemplateId("fileTemplate")
                                    .HtmlAttributes(new { accept = "image/*", id = "EditImage" })
                                    .Multiple(false)
                                    .Async(a => a
                                    .Save("EditSponsor", "SponsorUI")
                                    .AutoUpload(false))
                                    .Events(c => c
                                    .Upload("onUploadSponsorEdit").Success("onSuccessUploadDataEditSponsor")
                                    .Select("onSelectImageSponsor")
                                    )
                                )
                            </div> 
                            <div class="form-group">
                                <div class="col-md-offset-2 col-md-8">
                                    @*<input id="btnSubmitEditSponsor" onclick="submitEditSponsor()" type="button" value="@LayoutRES.Submit" class="btn btn-default" />*@
                                    <input id="btnSubmitEditSponsor" onclick="submitEditSponsor()" type="button" value="@LayoutRES.Submit" class="btn btn-info" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
