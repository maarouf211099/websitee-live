<script id="load kendo  Editable drop down list">
    $("#ddlInventoryItemId").kendoDropDownList({
        dataTextField: "Name",
        dataValueField: "Id",
        dataSource: InventoryItemsArr,
        filter: "contains",
        width:"100%",

    });
    $("#ddlCaseId").kendoDropDownList({
        dataTextField: "Id",
        dataValueField: "Id",
        dataSource: CasesArr,
        filter: "contains",
        width:"100%",

    });

</script>

