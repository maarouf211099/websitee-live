<script type="text/javascript">
    $(document).ready(function () {
        function onSelect(e) {
            switch ($(e.item).index()) {
                case 1:
                    //bind Privileges
                    bindPrivileges();
                    break;
                case 2:
                    //bind Groups
                    bindGroups();
                    break;
                case 3:
                    //bind Roles
                    bindRoles();
                    break;
                case 4:
                    bindMenus();
                    break;
            }

        }
        $(".AccordionDiv").accordion({
            collapsible: true,
            active: true,
            header: "h3",
            heightStyle: "content",
        });
        $("#tabstrip").kendoTabStrip({
            select: onSelect,
            animation: {
                open: {
                    effects: "fadeIn"
                }
            }
        });
    });

    function initialzeUserTabs() {
        var tabStrip = $("#tabstrip").kendoTabStrip().data("kendoTabStrip");
        tabStrip.select(0);
    }
</script>
<script type="text/javascript">
    $(function () {
        searchWithdrawPermissions();

        $('#btnSearch_User').click(function (evt) {
            searchWithdrawPermissions();
        });
    });

    function searchWithdrawPermissions() {
        //var jsonObject = searchObjectBuilder.getJsonSearchObj('searchBox_User input');
        //var strJSON = JSON.stringify(jsonObject);
        var _data = {
            "isNotConfirmedFilter": true,
            "isDeletedFilter": false
        };
        $.ajax({
            url: '@ConfigurationManager.AppSettings["MersalWebAPIBaseUrl"]' + 'api/StoreOperations/GetAllWithdrawPermissions?isNotConfirmedFilter=True&isDeletedFilter=false',
            cache: false,
            type: "POST",
            headers: getHeaders(),
            dataType: 'json',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(_data),
            success: function (data) {
                bindWithdrawPermissionsGrid(data);
            },
            error: function (xhr) {
                toastr.error(xhr.statusText);
            },
            async: true,
            processData: false
        });
    }
    function RefreshWithdrawPermissions() {
        //var jsonObject = searchObjectBuilder.getJsonSearchObj('searchBox_User input');
        //var strJSON = JSON.stringify(jsonObject);
        var _data = {
            "isNotConfirmedFilter": true,
            "isDeletedFilter": false
        };
        $.ajax({
            url: '@ConfigurationManager.AppSettings["MersalWebAPIBaseUrl"]' + 'api/StoreOperations/GetAllWithdrawPermissions?isNotConfirmedFilter=True&isDeletedFilter=false',
            cache: false,
            type: "Post",
            dataType: 'json',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(_data),
            //data: strJSON,
            success: function (data) {
                ds1 = new kendo.data.DataSource({
                    data: data
                });

                var grid = $("#WithdrawPermissions_Grid").data("kendoGrid");
                grid.dataSource = ds1;
                ds1.read();
                grid.refresh();
            },
            error: function (xhr) {
                toastr.error(xhr.statusText);
            },
            async: true,
            processData: false
        });
    }
</script>
<script type="text/javascript">
    function bindWithdrawPermissionsGrid(jsonData) {
        var firstDeleteRequest = 1;

        var isHidden = !$("#IsActiveUser").is(":checked");

        var commands = [{
            name: "details",
            text: "",
            iconClass: "fa fa-file-text-o fa-fw fa-2x",
            click: function (e) {
                var tr = $(e.target).closest("tr");
                var id = tr.find('.id-cell').text();

                EditWithdrawPermission(id);
            }
        },
               {
                   name: "delete",
                   text: "",
                   iconClass: "fa fa-trash-o fa-fw fa-2x",
                   click: function (e) {
                       var tr = $(e.target).closest("tr");
                       var id = tr.find('.id-cell').text();

                       var CallBackFunction = function () { DeleteWithdrawPermission(tr, id); };
                       confirmMessage("Confirmation", "are you sure you want to delete", 400, 250, CallBackFunction);


                       //DeleteWithdrawPermission(tr, id);
                       $(this).disabled = true;

                   }
               }];

        _columns = [
                { field: "Id", filterable: false, hidden: true, attributes: { "class": "id-cell" } },
                { field: "Quantity", title: "@StoreOperationsRes.Quantity" },
            {
                field: 'StoreName',
                title: "@StoreOperationsRes.StoreId",
                filterable: true
            },
            {
                field: 'InventoryItemName',
                title: "@StoreOperationsRes.InventoryItemId",
                filterable: true
            },
            {
                field: 'CaseCode',
                title: "@StoreOperationsRes.CaseId",
                filterable: true
            },
            {
                field: 'UserName',
                title: "@StoreOperationsRes.UserId",
                filterable: true
            },
            {
                template: "#=getConfirmTemplate(Id,IsConfirmed,Quantity,AvailableQuantityAtStore)#",
                title: "@StoreOperationsRes.Confirm",
            },
            {
                field: "AvailableQuantityAtStore",
                title: "@StoreOperationsRes.AvailableQuantity",
            },


            @*{
                field: "ExpirationDateString",
                title: "@StoreOperationsRes.ExpirationDate",
            },*@
            @*{

                template: "#=IsDeposit ? ArrivalOrExchangeDateString: ''#",
                field: "ArrivalOrExchangeDateString",
                title: "@StoreOperationsRes.DepositDate",
            },*@
            @*{
                template: "#=IsDeposit ?'':ArrivalOrExchangeDateString#",
                field: "ArrivalOrExchangeDateString",
                title: "@StoreOperationsRes.WithdrawDate",
            },*@
            {
                title: '@LayoutRES.Manage',
                command: commands,
                width: 200
            }]

        $("#WithdrawPermissions_Grid").html("");
        $("#WithdrawPermissions_Grid").kendoGrid({
            groupable: false,
            scrollable: false,
            sortable: true,
            editable: true,
            pageable: {
                pageSize: 10,
                refresh: false
            },
            selectable: "multiple cell",
            allowCopy: {
                delimeter: ",",
            },
            columns: _columns,
            filterable: {
                extra: false,
                messages: {
                    filter: "@CommonRes.Filter", // sets the text for the "Filter" button
                    clear: "@CommonRes.Clear", // sets the text for the "Clear" button

                    // when filtering boolean numbers
                    isTrue: "@CommonRes.IsTrue", // sets the text for "isTrue" radio button
                    isFalse: "@CommonRes.IsFalse", // sets the text for "isFalse" radio button

                    //changes the text of the "And" and "Or" of the filter menu

                    and: "@CommonRes.And",
                    or: "@CommonRes.Or",
                    itemsPerPage: "@CommonRes.ItemsPerPage",
                    of: "@CommonRes.Of",
                    items: "@CommonRes.Items"

                }
                , operators: {
                    //filter menu for "string" type columns
                    string: {
                        EqualsTo: "@CommonRes.EqualsTo",
                        NotEqualTo: "@CommonRes.NotEqualTo",
                        StartsWith: "@CommonRes.StartsWith",
                        EndsWith: "@CommonRes.EndsWith",
                        Contain: "@CommonRes.Contain",
                        doesNotContain: "@CommonRes.DoesNotContain",
                        IsGreaterThan: "@CommonRes.IsGreaterThan",
                        IsLessThan: "@CommonRes.IsLessThan",
                        IsGreaterThanOrEqualTo: "@CommonRes.IsGreaterThanOrEqualTo",
                        IsLessThanOrEqualTo: "@CommonRes.IsLessThanOrEqualTo"
                    },

                }
            },
            dataSource: {
                data: jsonData,
                schema: {
                    model: { id: "Id" }
                }
            }
        });
    }
</script>

