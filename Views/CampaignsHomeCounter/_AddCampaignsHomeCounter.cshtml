
@model DTO.Pharmacy.CampaignsHomeCounterDtos.AddCampaignsHomeCounterDto
@using Resource
@using UserUI.Helper

@{
    bool isArabic = UserUI.Helper.CultureHelper.GetCurrentCulture() == "ar-SA";
    var floatToRight = (CultureHelper.IsRighToLeft() ? "floatToRight" : "");
    var textAlignRight = isArabic ? "text-align: right;" : "";
    var dir = isArabic ? "rtl" : "ltr";
}
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>



<div class="modal fade" id="AddCampaignsHomeCounterModals" role="dialog" dir="@dir">
    <div class="modal-dialog" style="width: 900px;">
        <!-- Modal content-->
        <div class="modal-body">
            <div class="box box-info">
                <div class="box-header with-border">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">@StoreRes.Add</h4>
                </div>
                <!-- /.box-header -->
                <!-- form start -->
                @using (Html.BeginForm("Create", "CampaignsHomeCounter", null, FormMethod.Post, new { @class = "form-horizontal", id = "AddCampaignsHomeCounterForm" }))
                {
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(model => model.Id)
                    @Html.HiddenFor(model => model.DonationDestinationIds)
                    @Html.HiddenFor(model => model.ProjectDestinationId)

                    @Html.HiddenFor(model => model.ImageURL)
                    <div class="box-body">
                        <div class="row">
                            <div class="col-md-6">
                                @Html.DisplayNameFor(m => m.TitleAr)*
                                @Html.TextBoxFor(m => m.TitleAr, null, new { @class = "form-control", placeholder = Html.DisplayNameFor(m => m.TitleAr) })
                                @Html.ValidationMessageFor(m => m.TitleAr)
                            </div>
                            <div class="col-md-6">
                                @Html.DisplayNameFor(m => m.TitleEn)*
                                @Html.TextBoxFor(m => m.TitleEn, null, new { @class = "form-control", placeholder = Html.DisplayNameFor(m => m.TitleEn) })
                                @Html.ValidationMessageFor(m => m.TitleEn)
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">

                                @Html.DisplayNameFor(m => m.GoalTotal)*
                                @Html.TextBoxFor(m => m.GoalTotal, null, new { @class = "form-control", @type = "number", placeholder = Html.DisplayNameFor(m => m.GoalTotal) })
                                @Html.ValidationMessageFor(m => m.GoalTotal)
                            </div>
                            <div class="col-md-6">
                                @Html.DisplayNameFor(m => m.GoalUnit)*
                                @Html.TextBoxFor(m => m.GoalUnit, null, new { @class = "form-control", placeholder = Html.DisplayNameFor(m => m.GoalUnit) })
                                @Html.ValidationMessageFor(m => m.GoalUnit)
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                @Html.DisplayNameFor(m => m.GoalAverageAmount)*
                                @Html.TextBoxFor(m => m.GoalAverageAmount, null, new { @class = "form-control", @type = "number", placeholder = Html.DisplayNameFor(m => m.GoalAverageAmount) })
                                @Html.ValidationMessageFor(m => m.GoalAverageAmount)
                            </div>
                            <div class="col-md-6">
                                @Html.DisplayNameFor(m => m.DonationDestinationIds)
                                <select id="SelectDonationDestinationIds"></select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                @Html.DisplayNameFor(m => m.StartedOn)*
                                @Html.TextBoxFor(m => m.StartedOn, new { @class = "form-control", @type = "date", placeholder = Html.DisplayNameFor(m => m.StartedOn) })
                                @Html.ValidationMessageFor(m => m.StartedOn)
                            </div>
                            <div class="col-md-6">
                                @Html.DisplayNameFor(m => m.EndedOn)
                                @Html.TextBoxFor(m => m.EndedOn, new { @class = "form-control", @type = "date", placeholder = Html.DisplayNameFor(m => m.EndedOn) })
                                @Html.ValidationMessageFor(m => m.EndedOn)
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                @Html.DisplayNameFor(m => m.DescriptionAr)*
                                @Html.TextAreaFor(m => m.DescriptionAr, new { @class = "form-control", placeholder = Html.DisplayNameFor(m => m.DescriptionAr) })
                                @Html.ValidationMessageFor(m => m.DescriptionAr)
                            </div>
                            <div class="col-md-6">
                                @Html.DisplayNameFor(m => m.DescriptionEn)*
                                @Html.TextAreaFor(m => m.DescriptionEn, new { @class = "form-control", placeholder = Html.DisplayNameFor(m => m.DescriptionAr) })
                                @Html.ValidationMessageFor(m => m.DescriptionAr)
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                @Html.DisplayNameFor(m => m.IsActive)
                                @Html.CheckBoxFor(m => m.IsActive)
                                @Html.ValidationMessageFor(m => m.IsActive)
                            </div>
                            <div class="col-md-6">
                                <input id="inp" type="file" onchange="getBaseUrl()">
                                <p hidden id="b64"></p>
                                @if (Model.ImageURL != null && Model.ImageURL != "")
                                {
                                    <img id="img" src="@Url.Content(Model.ImageURL)" height="150" width="150">
                                }
                                else
                                {
                                    <img id="img" height="150" width="150">

                                }
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                @Html.DisplayNameFor(m => m.ProjectDestinationId)

                                @Html.DropDownListFor(x => x.ProjectDestinationId, new List<SelectListItem>(), new { @class = "form-control increase-width ProjectDestinationId", placeholder = "test", onchange= "ProjectDestinationidchange()" })
                                @Html.ValidationMessageFor(x => x.ProjectDestinationId)َ
                            </div>
                            <div class="col-md-6">
                                @CampaignsHomeCounterRes.ProjectDestinationId
                                <input type="text" onchange= "ProjectDestinationurlchange()" class="form-control ProjectDestinationUrl"  />

                            </div>
                        </div>
                    </div>

                    <!-- /.box-body -->
                    <div class="box-footer">
                        <button type="submit" class="btn btn-info">@LayoutRES.Submit</button>
                        <button type="button" class="btn btn-default" data-dismiss="modal">@LayoutRES.Close</button>
                    </div><!-- /.box-footer -->
                }
            </div>
        </div>
    </div>
</div>



<script>
    $(document).ready(function () {
       
    });

    function getBaseUrl() {
        var file = document.querySelector('input[type=file]')['files'][0];
        var reader = new FileReader();
        var baseString;
        reader.onloadend = function () {
            baseString = reader.result;
            console.log(baseString);
            $("#img").attr("src", baseString);
            $("#b64").text(baseString);
        };
        reader.readAsDataURL(file);
    }
</script>