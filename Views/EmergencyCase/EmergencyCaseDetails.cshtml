@model DTO.Emergency.EmergencyCaseDetailsDTO

@using Resource.Emergency
@using Resource
@using UserUI.Helper
@using DTO
@using System.Configuration
@using Kendo.Mvc.UI
@using System.Globalization
@{
    if (Model != null)
    {
        ViewBag.Title = Model.Code + " : " + Model.CaseName;
    }
    else
    {
        ViewBag.Title = "No Date Available";
    }
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    bool isArabic = UserUI.Helper.CultureHelper.GetCurrentCulture() == "ar-SA";
    var floatToRight = (CultureHelper.IsRighToLeft() ? "floatToRight" : "");
    var textAlignRight = isArabic ? "text-align: right;" : "";
    var dir = isArabic ? "rtl" : "ltr";
    var schedulerClass = isArabic ? "k-rtl" : "";

}

@if (Model == null)
{
    return;
}


<div class="modal fade" id="MedicalCoordinatorApprovalBox" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-body">
            <div class="box box-info">
                <div class="box-header with-border">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">@EmergencyCaseRES.MedicalOpinion</h4>
                </div>

                <div class="box-body AccordionDiv">

                </div>
                <div class="box-body" id="CaseVisitResultText">
                    @Html.TextAreaFor(x => x.Notes, new { style = textAlignRight, @class = "form-control", placeholder = EmergencyCaseRES.Notes, rows = "5", id = "AcceptanceNote" })
                </div>
                <div class="box-footer">
                    <button type="button" class="btn btn-info pull-right" onclick="AddNotes(@Model.EmergencyCaseId,true)">@CaseResources.Accept</button>
                    <button type="button" class="btn btn-default pull-left" data-dismiss="modal">@LayoutRES.Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="MedicalCoordinatorRejectionBox" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-body">
            <div class="box box-info">
                <div class="box-header with-border">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">@EmergencyCaseRES.RejectionReason</h4>
                </div>

                <div class="box-body AccordionDiv">

                </div>
                <div class="box-body" id="CaseVisitResultText">
                    @Html.TextAreaFor(x => x.Notes, new { style = textAlignRight, @class = "form-control", placeholder = EmergencyCaseRES.Notes, rows = "5", id = "RejectionNote" })
                </div>
                <div class="box-footer">
                    <button type="button" class="btn btn-info pull-right" onclick="AddNotes(@Model.EmergencyCaseId,false)">@EmergencyCaseRES.DataMissing</button>
                    <button type="button" class="btn btn-default pull-left" data-dismiss="modal">@LayoutRES.Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ChangeEmergencyCaseStateBox" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-body">
            @using (Html.BeginForm(null, null, null, FormMethod.Post, new { @class = "form-horizontal", id = "ChangeEmergencyCaseStateForm" }))
            {
                <div class="box box-info">
                    <div class="box-header with-border">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 class="modal-title">@EmergencyCaseRES.ChangeEmergencyCaseState</h4>
                    </div>

                    <div class="box-body AccordionDiv">
                        <div class="col-sm-8">
                            @Html.DropDownList("ChangeCaseState", new List<SelectListItem>() {
                             new SelectListItem() { Value = ((int)EmergencyCaseState.EmcRequireOxygen).ToString() , Text = EmergencyCaseRES.EmergencyCaseRequireOxygen}
                           , new SelectListItem() { Value = ((int)EmergencyCaseState.EmcNeedIsolation).ToString(), Text = EmergencyCaseRES.EmergencyCaseNeedIsolation}
                          }, "", new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="box-body" id="CaseVisitResultText">
                        @Html.TextAreaFor(x => x.Notes, new { style = textAlignRight, @class = "form-control", placeholder = EmergencyCaseRES.Notes, rows = "5", id = "ChangeStateNote", name = "ChangeStateNote" })
                    </div>
                    <div class="box-footer">
                        <button type="submit" class="btn btn-info pull-right">@EmergencyCaseRES.ChangeEmergencyCaseState</button>
                        <button type="button" class="btn btn-default pull-left" data-dismiss="modal">@LayoutRES.Close</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="ChangeEmergencyCaseStateByEmergencyDoctorBox" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-body">
            @using (Html.BeginForm(null, null, null, FormMethod.Post, new { @class = "form-horizontal", id = "ChangeEmergencyCaseStateByEmergencyDoctorForm" }))
            {
                <div class="box box-info">
                    <div class="box-header with-border">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 class="modal-title">@EmergencyCaseRES.ChangeEmergencyCaseState</h4>
                    </div>

                    <div class="box-body AccordionDiv">
                        <div class="col-sm-8">
                            @Html.DropDownList("ChangeCaseStateByEmergencyDoctor", new List<SelectListItem>() {
                                 new SelectListItem() { Value = ((int)EmergencyCaseState.EmcWaittingHospital).ToString(),  Text = EmergencyCaseRES.EmergencyCaseWaittingHospital }
                               ,  new SelectListItem() { Value = ((int)EmergencyCaseState.EmcRefusedFromEmcTeam).ToString(), Text = EmergencyCaseRES.EmergencyTeamRefusedEmergencyCase }
                                , new SelectListItem() { Value = ((int)EmergencyCaseState.EmcCL).ToString(), Text = EmergencyCaseRES.Closed }
                            }, "", new { @class = "form-control" })
                        </div>

                    </div>
                    <div class="box-body" id="CaseVisitResultText">
                        @Html.TextAreaFor(x => x.Notes, new { style = textAlignRight, @class = "form-control", placeholder = EmergencyCaseRES.Notes, rows = "5", id = "ChangeStateNoteByEmergencyDoctor" })
                    </div>
                    <div class="box-footer">
                        <button type="submit" class="btn btn-info pull-right">@EmergencyCaseRES.ChangeEmergencyCaseState</button>
                        <button type="button" class="btn btn-default pull-left" data-dismiss="modal">@LayoutRES.Close</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="ChangeEmergencyCaseStateToDoneBox" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-body">
            @using (Html.BeginForm(null, null, null, FormMethod.Post, new { @class = "form-horizontal", id = "ChangeEmergencyCaseStateToDoneForm" }))
            {
                <div class="box box-info">
                    <div class="box-header with-border">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 class="modal-title">@EmergencyCaseRES.ChangeEmergencyCaseState</h4>
                    </div>

                    <div class="box-body">
                        <div class="form-group">
                            <div class="col-md-5">
                                @EmergencyCaseRES.ExactHospitalName
                                <br />
                                @Html.TextBoxFor(x => x.HospitalName, new { style = textAlignRight, @class = "form-control" })
                            </div>

                            <div class="col-md-5">
                                @EmergencyCaseRES.HospitalAttendDate
                                <br />
                                @Html.TextBoxFor(x => x.HospitalEntryDate, new { style = textAlignRight, @class = "dates form-control" })
                            </div>

                        </div>
                        <div class="form-group">
                            <div class="col-md-5">
                                @EmergencyCaseRES.Amount
                                <br />
                                @Html.TextBoxFor(x => x.RequiredAmount, new { style = textAlignRight, @class = "form-control" })
                            </div>
                        </div>

                    </div>
                    <div class="box-footer">
                        <button type="submit" class="btn btn-info pull-right">@EmergencyCaseRES.CaseDone</button>
                        <button type="button" class="btn btn-default pull-left" data-dismiss="modal">@LayoutRES.Close</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>


<div class="modal-body">
    <div class="box box-info">

        <div>
            @using (Html.BeginForm(null, null, null, FormMethod.Post, new { @class = "form-horizontal", id = "EditEmergencyCaseForm" }))
            {
                <div class="box-header with-border">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title" style="text-align: center;">@Model.Code - @Model.CaseName   </h4>
                    <input id="CaseIdHID" type="hidden" value="@Model.EmergencyCaseId" />
                    <input id="CaseState" type="hidden" value="@Model.State" />
                    @Html.HiddenFor(x => x.EmergencyCaseId)
                </div><!-- /.box-header -->
                <div class="box-body AccordionDiv" style="margin: 5px;">
                    <div class="headOfAccordion">
                        @CaseResources.BasicData
                    </div>
                    <div>
                        <div class="form-group">
                            <div class="col-sm-12">
                                @Html.DisplayNameFor(m => m.CaseName)
                                <br />
                                @Html.TextBoxFor(m => m.CaseName, new { @class = "form-control", placeholder = Html.DisplayNameFor(m => m.CaseName) })
                                @Html.ValidationMessageFor(m => m.CaseName)
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-4 @floatToRight">
                                @Html.DisplayNameFor(m => m.Age)
                                @Html.TextBoxFor(m => m.Age, new { @class = "form-control", placeholder = Html.DisplayNameFor(m => m.Age) })
                                @Html.ValidationMessageFor(m => m.Age)
                            </div>

                        </div>
                        <div class="form-group">
                            <div class="col-sm-4 @floatToRight">
                                @Html.DisplayNameFor(m => m.NameAnonymous)
                                @Html.TextBoxFor(m => m.NameAnonymous, new { @class = "form-control", placeholder = Html.DisplayNameFor(m => m.NameAnonymous) })
                                @Html.ValidationMessageFor(m => m.NameAnonymous)
                            </div>
                            <div class="col-sm-4 @floatToRight">
                                @Html.DisplayNameFor(m => m.PhoneNumberAnonymous)
                                @Html.TextBoxFor(m => m.PhoneNumberAnonymous, new { @class = "form-control", placeholder = Html.DisplayNameFor(m => m.PhoneNumberAnonymous) })
                                @Html.ValidationMessageFor(m => m.PhoneNumberAnonymous)
                            </div>
                        </div>

                    </div>
                    <div class="headOfAccordion">
                        @EmergencyCaseRES.MedicalData
                    </div>
                    <div>
                        <div class="form-group">
                            <div class="col-sm-4 ">
                                @Html.HiddenFor(x => x.State)
                                <label>
                                    @Html.DisplayNameFor(model => model.StateString) :
                                </label>
                                @Html.DisplayFor(model => model.StateString)
                            </div>
                            <div class="col-sm-4 ">
                                @Html.HiddenFor(x => x.DiagnosisId)
                                <label>
                                    @Html.DisplayNameFor(model => model.DiagnosisString) :
                                </label>
                                @Html.DisplayFor(model => model.DiagnosisString)
                            </div>
                        </div>

                        @if (Model.CoronaForm != null)
                        {

                            <div class="form-group">
                                <div class="col-sm-4 @floatToRight">
                                    <input type="hidden" value="@Model.CoronaForm.NeedId" id="coronaNeedId" />
                                    @Html.DisplayNameFor(m => m.CoronaForm.NeedId)
                                    @Html.DropDownListFor(x => x.CoronaForm.NeedId, new List<SelectListItem>(), new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.CoronaForm.NeedId)
                                </div>

                                <div class="col-sm-2 @floatToRight">
                                    @Html.DisplayNameFor(m => m.CoronaForm.DiseaseStartDateString)
                                    @Html.TextBoxFor(m => m.CoronaForm.DiseaseStartDateString, new { @class = "dates form-control"
                                                                         , placeholder = Html.DisplayNameFor(m => m.CoronaForm.DiseaseStartDateString) })
                                    @Html.ValidationMessageFor(m => m.CoronaForm.DiseaseStartDateString)
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-sm-4 @floatToRight">
                                    @Html.DisplayNameFor(m => m.CoronaForm.PCRTest)
                                    @Html.DropDownListFor(x => x.CoronaForm.PCRTest, new List<SelectListItem>() {
                                                                                    new SelectListItem() { Text=EmergencyCaseRES.Yes, Value="true" },
                                                                                    new SelectListItem() { Text=EmergencyCaseRES.No, Value="false" }
                                                                                    },"", new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.CoronaForm.PCRTest)
                                </div>
                                <div class="PCRTestContainer" style="@(!Model.CoronaForm.PCRTest ? "display:none":"")">
                                    <div class="col-sm-4 @floatToRight">
                                        @Html.DisplayNameFor(m => m.CoronaForm.PCRLocation)
                                        @Html.TextBoxFor(m => m.CoronaForm.PCRLocation, new { @class = "form-control", placeholder = Html.DisplayNameFor(m => m.CoronaForm.PCRLocation) })
                                        @Html.ValidationMessageFor(m => m.CoronaForm.PCRLocation)
                                    </div>
                                    <div class="col-sm-2 @floatToRight">
                                        @Html.DisplayNameFor(m => m.CoronaForm.PCRTestDateString)
                                        @Html.TextBoxFor(m => m.CoronaForm.PCRTestDateString, new { @class = "dates form-control"
                                                                             , placeholder = Html.DisplayNameFor(m => m.CoronaForm.PCRTestDateString) })
                                        @Html.ValidationMessageFor(m => m.CoronaForm.PCRTestDateString)
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-sm-4 @floatToRight">
                                    @Html.DisplayNameFor(m => m.CoronaForm.IsTheTempertureHigh)
                                    @Html.DropDownListFor(x => x.CoronaForm.IsTheTempertureHigh, new List<SelectListItem>() {
                                                                                    new SelectListItem() { Text=EmergencyCaseRES.Yes, Value="true" },
                                                                                    new SelectListItem() { Text=EmergencyCaseRES.No, Value="false" }
                                                                                    }, "", new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.CoronaForm.IsTheTempertureHigh)
                                </div>
                                <div class="tempertureContainer" style="@(!Model.CoronaForm.IsTheTempertureHigh ? "display:none":"")">
                                    <div class="col-sm-4 @floatToRight">
                                        @Html.DisplayNameFor(m => m.CoronaForm.Temperture)
                                        @Html.TextBoxFor(m => m.CoronaForm.Temperture, new { @class = "form-control", placeholder = Html.DisplayNameFor(m => m.CoronaForm.Temperture) })
                                        @Html.ValidationMessageFor(m => m.CoronaForm.Temperture)
                                    </div>
                                    <div class="col-sm-4 @floatToRight">
                                        @Html.DisplayNameFor(m => m.CoronaForm.IsTempertureDescreseByMedicine)
                                        @Html.DropDownListFor(x => x.CoronaForm.IsTempertureDescreseByMedicine, new List<SelectListItem>() {
                                                                                        new SelectListItem() { Text=EmergencyCaseRES.Yes, Value="true" },
                                                                                        new SelectListItem() { Text=EmergencyCaseRES.No, Value="false" }
                                                                                        }, "", new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.CoronaForm.IsTempertureDescreseByMedicine)
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-sm-4 @floatToRight">
                                    @Html.DisplayNameFor(m => m.CoronaForm.HasChronicDiseases)
                                    @Html.DropDownListFor(x => x.CoronaForm.HasChronicDiseases, new List<SelectListItem>() {
                                                                                    new SelectListItem() { Text=EmergencyCaseRES.Yes, Value="true" },
                                                                                    new SelectListItem() { Text=EmergencyCaseRES.No, Value="false" }
                                                                                    }, "", new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.CoronaForm.HasChronicDiseases)
                                </div>
                                <div class="chronicDiseasesNamesContainer" style="@(!Model.CoronaForm.HasChronicDiseases ? "display:none":"")">
                                    <div class="col-sm-4 @floatToRight">
                                        @Html.DisplayNameFor(m => m.CoronaForm.ChronicDiseasesNames)
                                        @Html.TextBoxFor(m => m.CoronaForm.ChronicDiseasesNames, new { @class = "form-control", placeholder = Html.DisplayNameFor(m => m.CoronaForm.ChronicDiseasesNames) })
                                        @Html.ValidationMessageFor(m => m.CoronaForm.ChronicDiseasesNames)
                                    </div>
                                </div>
                                <div class="col-sm-4 @floatToRight">
                                    @Html.DisplayNameFor(m => m.CoronaForm.Medicines)
                                    @Html.TextBoxFor(m => m.CoronaForm.Medicines, new { @class = "form-control", placeholder = Html.DisplayNameFor(m => m.CoronaForm.Medicines) })
                                    @Html.ValidationMessageFor(m => m.CoronaForm.Medicines)
                                </div>
                        </div>

                        <div class="form-group">
                            <div class="col-sm-4 @floatToRight">
                                @Html.DisplayNameFor(m => m.CoronaForm.UseOxygen)
                                @Html.DropDownListFor(x => x.CoronaForm.UseOxygen, new List<SelectListItem>() {
                                                                                new SelectListItem() { Text=EmergencyCaseRES.Yes, Value="true" },
                                                                                new SelectListItem() { Text=EmergencyCaseRES.No, Value="false" }
                                                                                }, "", new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.CoronaForm.UseOxygen)
                            </div>

                            <div class="usOxygenContainer" style="@(!Model.CoronaForm.UseOxygen ? "display:none":"")">
                                <div class="col-sm-4 @floatToRight">
                                    @Html.DisplayNameFor(m => m.CoronaForm.IsStillUseOxygen)
                                    @Html.DropDownListFor(x => x.CoronaForm.IsStillUseOxygen, new List<SelectListItem>() {
                                                                                    new SelectListItem() { Text=EmergencyCaseRES.Yes, Value="true" },
                                                                                    new SelectListItem() { Text=EmergencyCaseRES.No, Value="false" }
                                                                                    }, "", new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.CoronaForm.IsStillUseOxygen)
                                </div>
                                <div class="col-sm-4 @floatToRight">
                                    @Html.DisplayNameFor(m => m.CoronaForm.PercentageOfOxygen)
                                    @Html.TextBoxFor(m => m.CoronaForm.PercentageOfOxygen, new { @class = "form-control", placeholder = Html.DisplayNameFor(m => m.CoronaForm.PercentageOfOxygen) })
                                    @Html.ValidationMessageFor(m => m.CoronaForm.PercentageOfOxygen)
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-4 @floatToRight">
                                <input type="hidden" value="@Model.CoronaForm.CanEatAndDrink" id="coronaCanEatAndDrinkId" />
                                @Html.DisplayNameFor(m => m.CoronaForm.CanEatAndDrink)
                                @Html.DropDownListFor(x => x.CoronaForm.CanEatAndDrink, new List<SelectListItem>(), new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.CoronaForm.CanEatAndDrink)
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-sm-4 @floatToRight">
                                <input type="hidden" value="@Model.CoronaForm.CaseLocationId" id="coronaCaseLocationId" />
                                @Html.DisplayNameFor(m => m.CoronaForm.CaseLocationId)
                                @Html.DropDownListFor(x => x.CoronaForm.CaseLocationId, new List<SelectListItem>(), new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.CoronaForm.CaseLocationId)
                            </div>
                            <div class="hospitalLocationContainer" style="@(Model.CoronaForm.CaseLocationId == (int)CaseLocationType.EmerHospital ? "display:none":"")">
                                <div class="col-sm-4 @floatToRight">
                                    @Html.DisplayNameFor(m => m.CoronaForm.HospitalName)
                                    @Html.TextBoxFor(m => m.CoronaForm.HospitalName, new { @class = "form-control", placeholder = Html.DisplayNameFor(m => m.CoronaForm.PercentageOfOxygen) })
                                    @Html.ValidationMessageFor(m => m.CoronaForm.HospitalName)
                                </div>
                                <div class="col-sm-4 @floatToRight">
                                    <input type="hidden" value="@Model.CoronaForm.HospitalLocationId" id="coronaHospitalLocationId" />
                                    @Html.DisplayNameFor(m => m.CoronaForm.HospitalLocationId)
                                    @Html.DropDownListFor(x => x.CoronaForm.HospitalLocationId, new List<SelectListItem>(), new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.CoronaForm.HospitalLocationId)
                                </div>
                            </div>
                        </div>
                        <div id="serviceArea">
                            @Html.HiddenFor(x => x.CoronaForm.SymptomsIDs)
                            <div class="form-group" dir="@dir">
                                <div class="col-sm-12 @floatToRight">
                                    <label>
                                        @Html.DisplayNameFor(m => m.CoronaForm.SymptomsIDs)
                                    </label>
                                </div>
                                <br />
                                <div class="SymptomsIDsDiv @floatToRight">

                                </div>

                                @Html.ValidationMessageFor(m => m.CoronaForm.SymptomsIDs)
                            </div>

                            <div class="form-group otherContainer" style="@(string.IsNullOrEmpty(Model.CoronaForm.AddSymptomOtherText.OtherText) ? "display:none":"")">
                                @Html.HiddenFor(x => x.CoronaForm.AddSymptomOtherText.Id)
                                <div class="form-group" dir="@dir">
                                    <div class="col-sm-6 @floatToRight">
                                        @Html.TextBoxFor(x => x.CoronaForm.AddSymptomOtherText.OtherText, new { placeholder = EmergencyCaseRES.OtherEmergencyText })
                                    </div>
                                </div>
                            </div>


                            @Html.HiddenFor(x => x.CoronaForm.CoronaTestIDs)
                            <div class="form-group" dir="@dir">
                                <div class="col-sm-12 @floatToRight">
                                    <label>
                                        @Html.DisplayNameFor(m => m.CoronaForm.CoronaTestIDs)
                                    </label>
                                </div>
                                <br />
                                <div class="CoronaTestIdsDiv @floatToRight">

                                </div>

                                @Html.ValidationMessageFor(m => m.CoronaForm.CoronaTestIDs)
                            </div>
                            <div class="form-group" dir="@dir">
                                <div class="col-sm-12">
                                    @Html.Label(EmergencyCaseRES.PCRAndAnalysisAttachment)
                                </div>
                                <div class="attachment">
                                    @if (Model.EmergencyCaseAttachment.Any())
                                    {
                                        foreach (var item in Model.EmergencyCaseAttachment)
                                        {
                                            <a target="_blank" href="~/ClientFilesLayout/EmergencyCases/@item.EmergencyCaseId/@item.FileName">
                                                <img class="img-fluid" width="70" height="70" src="~/ClientFilesLayout/EmergencyCases/@item.EmergencyCaseId/@item.FileName" />
                                            </a>
                                        }
                                    }

                                </div>
                            </div>
                            @if (AuthorizationHelper.UserIsInPrivilege((int)EnumPrivilages.EditEmergencyCase))
                            {
                                <div class="form-group">
                                    <input type="hidden" id="CaseHaseFile" />
                                    <div class="demo-section k-content @schedulerClass">
                                        @(Html.Kendo().Upload()
                                                                                                                                                                                                                                                      .Name("files")
                                                                                                                                                                                                                                                       .Messages(m => m.Select(EmergencyCaseRES.PCRAndAnalysisAttachment).UploadSelectedFiles(""))
                                                                                                                                                                                                                                                      .TemplateId("fileTemplate")
                                                                                                                                                                                                                                                      .HtmlAttributes(new { id = "CaseFile" })
                                                                                                                                                                                                                                                      .Multiple(true)
                                                                                                                                                                                                                                                      .Async(a => a
                                                                                                                                                                                                                                                      .Save("UploadCaseAttachment", "EmergencyCase")
                                                                                                                                                                                                                                                      .AutoUpload(false)
                                                                                                                                                                                                                                                      .Batch(true)
                                                                                                                                                                                                                                                      )
                                                                                                                                                                                                                                                      .Events(c => c
                                                                                                                                                                                                                                                      .Upload("onUploadEmergencyNewCase").Success("onSuccessUploadNewEmergencyCase")
                                                                                                                                                                                                                                                      .Select("onEmergencySelectCaseFile")
                                                                                                                                                                                                                                                      )
                                        )
                                    </div>
                                    <div class="divStatus"></div>
                                </div>
                            }
                        </div>

                    }
                    else if (Model.EmergencyForm != null)
                    {
                        <div class="form-group">
                            <div class="col-sm-6 @floatToRight">
                                <label>
                                    @Html.DisplayNameFor(model => model.EmergencyForm.Description) :
                                </label>
                                @Html.TextAreaFor(m => m.EmergencyForm.Description, new { style = textAlignRight, @class = "form-control", placeholder = Html.DisplayNameFor(m => m.EmergencyForm.Description), rows = "4" })
                                @Html.ValidationMessageFor(m => m.EmergencyForm.Description)
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-6 @floatToRight">
                                <label>
                                    @Html.DisplayNameFor(model => model.EmergencyForm.Requirements) :
                                </label>
