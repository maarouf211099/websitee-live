@model IEnumerable<DTO.CaseEmployeeDTO>
@using Resource
@using System.Globalization
@using UserUI.Helper
@using Kendo.Mvc.UI
@{
    bool isArabic = UserUI.Helper.CultureHelper.GetCurrentCulture() == "ar-SA";
    var floatToRight = (CultureHelper.IsRighToLeft() ? "floatToRight" : "");
    var textAlignRight = isArabic ? "text-align: right;" : "";
    var dir = isArabic ? "rtl" : "ltr";
}

<div class="modal fade" id="AssginCaseToEmployeeModals" role="dialog" dir="@dir">
    <div class="modal-dialog">
        <div class="modal-body">
            <div class="box box-info">
                <div class="box-header with-border">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">@CaseResources.AssginToEmployee</h4>
                </div><!-- /.box-header -->
                <form class="form-horizontal" id="frmAssginCaseToEmployee">
                    <div class="box-body">
                        <input id="CaseEmployee_CaseId" type="hidden" name="CaseId" value="@Model.First().CaseId" />
                        <input id="EmployeeId" type="hidden" name="UserId" value="0" />
                        <input id="EmployeeEmail" type="hidden" name="Email" value="" />
                        @if (Model.First().UserId != 0)
                        {
                            <table class="table table-bordered" style="@textAlignRight">
                                <tbody id="Userstable">
                                    <tr>
                                        <th style="@textAlignRight">@CaseResources.Income</th>
                                        <th style="@textAlignRight">@CaseResources.Amount</th>
                                        <th style="@textAlignRight">@LayoutRES.Delete</th>
                                    </tr>

                                    @foreach (var caseEmp in Model)
                                    {
                                        <tr id="@caseEmp.Id">
                                            <td>@caseEmp.EmployeeName</td>
                                            <td>@(caseEmp.IsDone ? LayoutRES.Done : CaseResources.ActiveNow) </td>
                                            
                                                @if (!caseEmp.IsDone)
                                                {
                                                    <td>
                                                        <i class="fa fa-trash" style="cursor:pointer" onclick="DeleteEmployeeAssign('@caseEmp.Id')"></i>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td></td>
                                                }
                                        </tr>
                                    }

                                </tbody>
                            </table>
                            @*foreach (var caseEmp in Model)
                                {
                                    if (caseEmp.IsDone)
                                    {
                                        if (caseEmp.UpdatedOn.HasValue)
                                        {
                                            <label>@caseEmp.EmployeeName - @LayoutRES.Done - @caseEmp.UpdatedOn.Value.ToString("d/M/yyyy HH:mm", CultureInfo.InvariantCulture)</label>
                                        }
                                        else
                                        {
                                            <label>@caseEmp.EmployeeName - @LayoutRES.Done</label>
                                        }
                                    }
                                    else
                                    {
                                        <label>@caseEmp.EmployeeName - @CaseResources.ActiveNow</label>
                                    }*@
                            <br />
                        
                        }
                        <div class="form-group">
                            <div class="col-md-8">
                                @Html.Label(CaseResources.SearchForEmployee, new { @class = "control-label" })
                                @(Html.Kendo().ComboBox()
                                    .Name("SearchForEmployee2")
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    .HtmlAttributes(new { style = "width:100%", @aria_required = "true" })
                                    .Filter(FilterType.Contains)
                                    .Suggest(true)
                                    .Events(e => e
                                    .Select("SetEmployeeData")
                                    .Change("SetEmployeeData")
                                    )
                                    .HighlightFirst(true)
                                    .DataSource(source =>
                                    {
                                        source.Custom()
                                       .ServerFiltering(true).ServerPaging(true).Type("aspnetmvc-ajax")
                                       .Transport(transport =>
                                       {
                                           transport.Read(r => r.Action("GetUsersByLocationCodeKendo", "Case", new { locationCode = "fu" }) // .Data("DateTypeId")
                                           );
                                       })
                                       .Schema(schema => { schema.Data("Data").Total("Total"); });
                                    }))
                            </div>
                        </div>
                    </div>

                    <div class="box-footer">
                        <input id="btnAssginEmployee" type="submit" value="@LayoutRES.Submit" class="btn btn-info pull-right" />
                        <button type="button" data-dismiss="modal" class="btn btn-default pull-left">@LayoutRES.Close</button>
                    </div><!-- /.box-footer -->
                </form>

            </div>
        </div>
    </div>
</div>

