@model IEnumerable<DTO.EmailTemplateDTO>
@using UserUI.Helper
@using Resource
@using DTO
@{
    ViewBag.Title = EmailTemplateResource.EmailResources;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    bool isArabic = UserUI.Helper.CultureHelper.GetCurrentCulture() == "ar-SA";
    var floatToRight = (CultureHelper.IsRighToLeft() ? "floatToRight" : "");
    var textAlignRight = isArabic ? "text-align: right;" : "";
    var dir = isArabic ? "rtl" : "ltr";
    var tblTextAlign = isArabic ? "tblText" : "";
}
<style>
    .tblText tr {
        text-align: right;
    }

    .tblText th {
        text-align: right;
    }
</style>
<div class="row">
    <div class="col-xs-12">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">@EmailTemplateResource.EmailResources</h3>
            </div>
            <div class="box-body table-responsive no-padding">
                <table class="table table-hover">
                    <tbody class="@tblTextAlign">
                        <tr>
                            <th>@EmailTemplateResource.Name</th>
                            <th>@EmailTemplateResource.Subject</th>
                            <th>@EmailTemplateResource.Body</th>
                            <th>@EmailTemplateResource.Details </th>
                        </tr>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name </td>
                                <td>@item.Subject </td>
                                <td>@item.Body </td>
                                <td><span class="label label-success" style="cursor: pointer;" onclick="getDetailsEmail('@item.Id')">@EmailTemplateResource.Details</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div id="EditEmailDiv">

</div>

@section Scripts {
    @*<script src="~/Scripts/MersalScripts/LayoutManagment/EmailTemplate.js"></script>*@
    @Scripts.Render("~/bundles/EmailTemplate")
}

