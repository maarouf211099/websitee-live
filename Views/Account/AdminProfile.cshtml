                    toastr.success(SuccessfulProcess);
                    $("#btnIsDone").remove();
                    setTimeout(function () {
                        $('#scheduler').data('kendoScheduler').dataSource.read();
                        $('#scheduler').data('kendoScheduler').refresh();
                    }, 100);
                },
                error: function (xhr) {
                    toastr.error(xhr.statusText);
                }
            });
        }
