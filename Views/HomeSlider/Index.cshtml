<div class="@(CultureHelper.IsRighToLeft() ? "k-rtl" : "")">
    @(Html.Kendo().Grid((List<HomeSliderDTO>)Model)
              .Name("Grid")
              .Pageable(pager => pager.Refresh(true))
              .Sortable().Groupable(g => g.Messages(m => m.Empty(LayoutRES.DragaColumnHeaderAndDropItHereToGroupByThatColumn)))
              .Columns(columns =>
              {
                  columns.Bound(e => e.Title);
                  columns.Bound(e => e.TitleAr);
                  columns.Bound(e => e.Subtitle);
                  columns.Bound(e => e.SubTitleAr);
                  columns.Bound(e => e.ImagePath).ClientTemplate("<img src='#=ImagePath#' style='max-width:150px;' />") ;
                  columns.Template(e => e.Id).ClientTemplate("<a class='btn btn-info'  onclick=getSlideDetails('#=Id#')> " + CampaignResource.Edit + "</a>").Width(50).Title(LayoutRES.Edit);
                  columns.Template(e => e.Id).ClientTemplate("<a class='btn btn-info'  onclick=DeleteSlide('#=Id#')>" + CampaignResource.Delete + "</a>").Width(50).Title(LayoutRES.Delete);
              })
              .DataSource(dataSource => dataSource.Ajax().PageSize(10).Read(read => read.Action("Index", "HomeSlider")))
    )
</div>
<br />



<div id="CreateSlideDiv">
