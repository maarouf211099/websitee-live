@using Resource

<div id="donationsCarousel" class="carousel slide" data-ride="carousel">
    <div class="carousel-inner" role="listbox">
        @for (int i = 0; i < Model.Count; i += 3)
        {
            <div class="item @(i == 0 ? "active" : "")">
                <div class="row">
                    @for (int j = i; j < i + 3 && j < Model.Count; j++)
                    {
                        <div class="col-md-4">
                            <div class="row">
                                <div class="col-lg-4 d-flex align-items-center justify-content-center">
                                    <img src="@Model[j].LogoPath" class="img-responsive" alt="" />
                                </div>
                                <div class="col-lg-8 arrow2">
                                    @foreach (var bank in Model[j].DonationAccounts)
                                    {
                                        <h5 class="text-center">
                                            <span>@bank.Currency | </span>
                                            @bank.AccountNumber
                                        </h5>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
    <a class="left carousel-control" href="#donationsCarousel" role="button" data-slide="prev">
        <span class="glyphicon glyphicon-chevron-left" aria-hidden="true"></span>
        <span class="sr-only">Previous</span>
    </a>
    <a class="right carousel-control" href="#donationsCarousel" role="button" data-slide="next">
        <span class="glyphicon glyphicon-chevron-right" aria-hidden="true"></span>
        <span class="sr-only">Next</span>
    </a>
</div>

<!-- Include Bootstrap CSS and JS -->


<style>
    .donations-tabsets .arrow2 {
        background: #e4f3f3;
        padding: 10px;
        position: relative;
    }
    .donations-tabsets .arrow2:before {
        content: "";
        position: absolute;
        width: 0px;
        height: 0px;
        border: 10px solid;
        border-color: transparent transparent transparent #e4f3f3;
        right: -20px;
        top: 34%;
    }
    .donations-tabsets .boxBank h5 {
        font-size: 12px;
        font-weight: 600;
        line-height: 0.84;
        color: #616161;
    }
    .donations-tabsets .boxBank .row {
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .donations-tabsets .boxBank span {
        margin: 0px 5px;
        font-size: 10px;
        font-weight: 600;
        line-height: 0.84;
        color: teal;
    }
    .carousel-inner .item {
        padding: 15px;
    }
    .carousel-inner .row {
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .carousel-item img {
        max-width: 100%;
        max-height: 100%;
        border-radius: 0px !important;
    }
    .carousel-control.left, .carousel-control.right {
        background-image: none;
    }
  
   .img-responsive{
       
        border-radius: 0px !important;
    }
</style>

<script>
    $(document).ready(function(){
        $('#donationsCarousel').carousel({
            interval: 3000
        });
    });
</script>
