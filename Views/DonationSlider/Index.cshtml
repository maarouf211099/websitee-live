}
<style>
    .tblText tr {
        text-align: right;
    }

    .tblText th {
        text-align: right;
    }
</style>
<div class="form-group">
    <button onclick="getCreateDonationSlide()" type="button" class="btn btn-info">@DonationSlideResource.CreateDonationSlide</button>
</div>
