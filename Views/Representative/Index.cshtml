@using System.Configuration
@using UserUI.Helper
@using Resource
@using DTO
@{
    ViewBag.Title = StoreRes.Representative;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    bool isArabic = UserUI.Helper.CultureHelper.GetCurrentCulture() == "ar-SA";
    var floatToRight = (CultureHelper.IsRighToLeft() ? "floatToRight" : "");
    var textAlignRight = isArabic ? "text-align: right;" : "";
    var dir = isArabic ? "rtl" : "ltr";
}
<head>
    <title>@StoreRes.Representative</title>
</head>
@if (AuthorizationHelper.UserIsInPrivilege((int)EnumPrivilages.CreateCasesAdmin))
{
    <button id="btnPopupCreateCase" onclick="AddNewRepresentative()" type="button" class="btn btn-info">@StoreRes.Add</button>
}

<br />
<br />


<div id="panelGrid" class="form-horizontal">
    <div id="grid" class="@(CultureHelper.IsRighToLeft() ? "k-rtl" : "")"></div>
</div>

<div id="createRepresentativeDiv"></div>



@section Scripts {
    <script>
        var Name = '@StoreRes.Name';
        var Code = '@StoreRes.Code';
        var IsActive='@StoreRes.Active'
    </script>
    <script src="~/Scripts/Representative/addRepresentative.js"></script>
    <script src="~/Scripts/Representative/RepresentativeIndex.js"></script>

    <script>
        $(document).ready(function () {
            RefreshGird();
        });
    </script>
}

