    GetAnyMasterDetalisCode('DoDs', 'DonationDestinationIdd', false, true, "", "", true,'@DonationResources.DonationDestination');
    GetBanks('DoDs', 'BankId', false, true, "", "", true,'@DonationResources.Bank');

