    <script>
        var editUserManagementForm = $("#editUserManagementForm");
        editUserManagementForm.submit(function (e) {
            $.validator.unobtrusive.parse(editUserManagementForm)
            e.preventDefault();
            if (!editUserManagementForm.valid()) return;
            var url = UserNamagementWebAPIBaseUrl + "api/User/UpdateUserDetails";
            var Submitdata = {};
            $("#editUserManagementForm").serializeArray().map(function (x) { Submitdata[x.name] = x.value; });
            $.ajax({
                type: "POST",
                contentType: "application/json",
                url: url,
                crossDomain: true,
                headers: getHeaders(),
                data: JSON.stringify(Submitdata),
                async: false,
                success: function (result) {
                    toastr.success(SuccessfulProcess);
                },
                error: function (xhr) {
                    toastr.error(xhr.error);
                }
            });
        });


