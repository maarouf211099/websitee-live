    Layout = "~/Views/Shared/_AdminLayout.cshtml"; 
    var sa = System.Configuration.ConfigurationManager.AppSettings["MersalWebAPIBaseUrl"];
    var gridUrl = sa + "CaseCustomAttribute/GetCustomAttrByCaseCategoryId";
}

<script>
    function DateTypeId() {
        return { masterCodeID: '@StaticIDs.DataTypeMasetCodeID' }
    }

    function CaseCategoryCode() {
        return { CaseCategoryCode: '@MasterCode.CasC' }
