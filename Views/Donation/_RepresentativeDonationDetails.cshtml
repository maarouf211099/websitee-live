            $('#DonationDestinationSubRepresentativeId').html('');

            var id = $('#DonationDestinationRepresentativeId').val();
            var placeHolder = _cultureIsArabic ? 'مخصص الى' : 'Dedicated to';
            GetByParentId('DonationDestinationSubRepresentativeId', id, 'DonationSubRepresentative', placeHolder);
        });

        $('#DonationDestinationSubRepresentativeId').change(function (e) {

            $('#DonationSubOfSubRepresentative').hide();
            $('#DonationDestinationSubOfSubRepresentativeId').html('');


            var code = this.options[this.selectedIndex].getAttribute('Code');
            if (code == "DonZkaCase") {
                $('#DonationDestinationRepresentativeCaseCode').show();
            }
            else {
                $('#DonationDestinationRepresentativeCaseCode').hide();
                $('#CaseId').val('');
                var id = $('#DonationDestinationSubRepresentativeId').val();
                var placeHolder = _cultureIsArabic ? 'مخصص الى' : 'Dedicated to';
                GetByParentId('DonationDestinationSubOfSubRepresentativeId', id, 'DonationSubOfSubRepresentative', placeHolder);
            }
        });


        $('#DonationDestinationSubOfSubRepresentativeId').change(function (e) {
            var code = this.options[this.selectedIndex].getAttribute('Code');
            if (code == "DonGeneralCase") {
                $('#DonationDestinationRepresentativeCaseCode').show();
            }
            else {
                $('#DonationDestinationRepresentativeCaseCode').hide();
                $('#CaseId').val('');
            }
        });
        

        $('#CurrencyId').change(function () {
            var selected = currancyList.find(({ Id }) => Id == $('#CurrencyId').val());
            if (selected.NameEn.trim() != 'EGP') {
                $('#BBFCYRate').show();
            } else {
                $('#BBFCYRate').hide();
            }

        });
    function GetNeedCar(dropDownId, itemToShow, placeholder) {
        var htmlGovernorate = "<option value=''>"+placeholder+"</option>";


        htmlGovernorate += "<option Code=\"" + 'true' + "\" value=" + true + " >" + '@DonationResources.Yes' + "</option>";
        htmlGovernorate += "<option Code=\"" + 'No' + "\" value=" + false + " >" + '@DonationResources.No' + "</option>";


        $("#" + dropDownId).html(htmlGovernorate);

        if (model.IsNeedCar != null && model.IsNeedCar == true) {
            $("#" + dropDownId).val("true");
        }
        else if (model.IsNeedCar != null && model.IsNeedCar == false) {
            $("#" + dropDownId).val("false");
        }
    }


    function GetAnyMasterDetalisCode(MasterCode, dropDownListId, enableAll, async, selectedId, PerantCode, emptyOption,placeholder) {
        $.ajax({
            type: "GET",
            contentType: "application/json",
            url: SystmeCodeWebAPIBaseUrl + "api/DetailCode/GetMasterCodeByMultiCode?masterCode=" + MasterCode,
            async: async,
            success: function (data) {
                var html = "";
                if (enableAll) {
                    if (_cultureIsArabic) {
                        html = "<option value='0'>الكل</option>";
                    }
                    else {
                        html = "<option value='0'>All</option>";
                    }
                }
                if (PerantCode) {
                    $.each(data, function (key, value) {
                        if (value.Parent) {
                            if (value.Parent.Code == PerantCode) {
                                var selec = "";
                                if (value.masterCodeValue == MasterCode) {
                                    if (value.Id == selectedId) selec = " selected='selected' ";
                                    if (_cultureIsArabic) {
                                        html += "<option Code=" + value.Code + " value=" + value.Id + selec + "  >" + value.NameAr + "</option>";
                                    }
                                    else {
                                        html += "<option Code=" + value.Code + " value=" + value.Id + selec + " >" + value.NameEn + "</option>";
                                    }
                                }
                            }
                        }
                    });
                }
                else {
                    $.each(data, function (key, value) {
                        var selec = "";
                        if (value.masterCodeValue == MasterCode) {
                            if (value.Id == selectedId) selec = " selected='selected' ";
                            if (_cultureIsArabic) {
                                html += "<option Code=" + value.Code + " value=" + value.Id + selec + "  >" + value.NameAr + "</option>";
                            }
                            else {
                                html += "<option Code=" + value.Code + " value=" + value.Id + selec + " >" + value.NameEn + "</option>";
                            }
                        }
                    });
                }
                $("#" + dropDownListId).html(html);
                if (emptyOption) {
                    $("#" + dropDownListId).prepend("<option value='' selected='selected'>" + placeholder+"</option>");
                }

                if (MasterCode == 'DonateThroughOtherMeansCurency') {
                    currancyList = data;
                    $('#CurrencyId').val(model.CurrencyId);
                    var selected = currancyList.find(({ Id }) => Id == $('#CurrencyId').val());
                    if (selected.NameEn.trim() != 'EGP') {
                        $('#BBFCYRate').show();
                    } else {
                        $('#BBFCYRate').hide();
                    }
                    
                }

                else if (MasterCode == 'MethodsPayingDonationBranches') {
                    $('#DonationPayWayId').val(model.DonationPayWayId);
                }

                else if (MasterCode == 'TypeDonor') {
                    $('#TypeDonorId').val(model.TypeDonorId);
                }

                else if (MasterCode == 'GEND') {
                    $('#GenderId').val(model.GenderId);
                }


                else if (MasterCode == 'Gove') {
                    $('#CountryId').val(model.CountryId);
                }

                else if (MasterCode == 'TypeAddress') {
                    $('#TypeAddressId').val(model.TypeAddressId);
                }

                else if (MasterCode == 'DoDs') {
                    $('#DonationDestinationRepresentativeId').val(model.DonationDestinationRepresentativeId);
                    var placeHolder = _cultureIsArabic ? 'مخصص الى' : 'Dedicated to';
                    if (model.DonationDestinationRepresentativeId != null) {
                        GetByParentId('DonationDestinationSubRepresentativeId', model.DonationDestinationRepresentativeId, 'DonationSubRepresentative', placeHolder);
                    }
                    if (model.DonationDestinationSubRepresentativeId != null) {
                        GetByParentId('DonationDestinationSubOfSubRepresentativeId', model.DonationDestinationSubRepresentativeId, 'DonationSubOfSubRepresentative', placeHolder);
                    }

                    if (model.CaseId != null) {
                        $('#DonationDestinationRepresentativeCaseCode').show();
                        $('#CaseId').val(model.CaseId);
                    }


                }


            },
            error: function (xhr) {
                toastr.error(xhr.statusText);
            }
        });


    }


        function GetByParentId(dropDownId, parentId, itemToShow, placeHolder = '') {
            var url = SystmeCodeWebAPIBaseUrl + "api/DetailCode/GetByParentId?parentId=" + parentId;
            $.ajax({
                type: "GET",
                contentType: "application/json",
                url: url,
                async: true,
                success: function (data) {

                    var htmlGovernorate = "<option  value=''>" + placeHolder + "</option>";
                    if (data != null) {
                        $.each(data, function (key, value) {
                            htmlGovernorate += "<option Code=\"" + value.Code + "\" value=" + value.Id + " >" + value.NameEn + "</option>";
                        });
                    }

                    $("#" + dropDownId).html(htmlGovernorate);
                    if (data != null && data.length != 0) {
                        $('#' + itemToShow).show();
                        //$("#" + dropDownId).rules("add", {
                        //    required: false,
                        //    messages: {
                        //        required: requiredDonationDestination
                        //    }
                        //});
                    }
                    if (itemToShow == 'DonationSubRepresentative' && model.DonationDestinationSubRepresentativeId!=null) {
                        $('#DonationDestinationSubRepresentativeId').val(model.DonationDestinationSubRepresentativeId);
                    }

                    if (itemToShow == 'DonationSubOfSubRepresentative' && model.DonationDestinationSubOfSubRepresentativeId!=null) {
                        $('#DonationDestinationSubOfSubRepresentativeId').val(model.DonationDestinationSubOfSubRepresentativeId);
                    }

                    if (itemToShow == 'Region' && model.RegionId != null) {
                        $('#RegionId').val(model.RegionId);
                    }
                },
                error: function (xhr) {
                    //toastr.error(xhr.statusText);
                }
            });

        }


