{
  "routes": [
    {
      "route": "/js/*",
      "headers": {
        "Cache-Control": "public, max-age=30, must-revalidate"
      }
    },
    {
      "route": "/css/*",
      "headers": {
        "Cache-Control": "public, max-age=30, must-revalidate"
      }
    },
    {
      "route": "/img/*",
      "headers": {
        "Cache-Control": "public, max-age=2592000, stale-while-revalidate=86400"
      }
    },
    {
      "route": "/fonts/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/admin",
      "redirect": "/admin/",
      "statusCode": 301
    },
    {
      "route": "/admin/*",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "Cache-Control": "no-cache",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
      }
    },
    {
      "route": "/Donation",
      "redirect": "/donate.html",
      "statusCode": 301
    },
    {
      "route": "/Donation/*",
      "redirect": "/donate.html",
      "statusCode": 301
    },
    {
      "route": "/home/ZakahCalculator",
      "redirect": "/zakat.html",
      "statusCode": 301
    },
    {
      "route": "/home/AfiaCard",
      "redirect": "/afia.html",
      "statusCode": 301
    },
    {
      "route": "/Album/*",
      "redirect": "/albums.html",
      "statusCode": 301
    },
    {
      "route": "/Case/*",
      "redirect": "/donate.html?for=cases",
      "statusCode": 301
    },
    {
      "route": "/InnerVideos/*",
      "redirect": "/albums.html",
      "statusCode": 301
    },
    {
      "route": "/Base/SetCulture",
      "redirect": "/",
      "statusCode": 301
    },
    {
      "route": "/home/contactus",
      "redirect": "/contact.html",
      "statusCode": 301
    },
    {
      "route": "/DynamicPage/RenderPage",
      "rewrite": "/legacy.html"
    },
    {
      "route": "/home/HosbitalDetals",
      "redirect": "/p/30.html",
      "statusCode": 301
    },
    {
      "route": "/home/ProjectListView",
      "redirect": "/#projects",
      "statusCode": 301
    },
    {
      "route": "/about.html",
      "redirect": "/p/3.html",
      "statusCode": 301
    },
    {
      "route": "/content.json",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/offline.html",
      "headers": {
        "Cache-Control": "no-cache",
        "X-Robots-Tag": "noindex"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "SAMEORIGIN",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  },
  "mimeTypes": {
    ".json": "application/json"
  },
  "platform": {
    "apiRuntime": "node:20"
  }
}
