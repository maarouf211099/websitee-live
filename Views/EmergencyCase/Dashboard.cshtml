                        }
                        @if (isArabic)
                        {
                            <p>@item.NameAr</p>
                        }
                        else
                        {
                            <p>@item.NameEn</p>
                        }
                    </div>
                    <div class="icon">
                      <i class="ion ion-locked"></i>
                    </div>
                    <a href="/EmergencyCase/Index?state=@item.code" class="small-box-footer">@LayoutRES.GO<i class="fa fa-arrow-circle-right"></i></a>
                </div>
            </div>
        }

 if (item.code=="EmcWaittingHospital")
        {

            <div class="col-lg-3 col-xs-6">
                <!-- small box -->
                <div class="small-box  bg-blue-gradient">
                    <div class="inner">
                        @if (item.CaseCount != null)
                        {
                            <h3>@item.CaseCount</h3>
                        }
                        else
                        {
                            <h3>0</h3>
                        }
                        @if (isArabic)
                        {
                            <p>@item.NameAr</p>
