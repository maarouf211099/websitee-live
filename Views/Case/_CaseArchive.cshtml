@model DTO.CaseArchiveDTO
@using Resource

<div class="modal fade" id="CaseArchiveModals" role="dialog" style="overflow-y: auto;">
    <div class="modal-dialog" style="width: 500px;">
        <div class="modal-body">
            <div class="box box-info">
                <div class="box-header with-border">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">@CaseResources.ArchivingCase</h4>
                </div>

                <div class="box-body" id="caseArchiveBody">
                    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form-horizontal", id = "CaseArchiveResultForm" }))
                    {
                        @Html.HiddenFor(x => x.CaseId)
                        <div class="box-footer">
                            <div class="form-group">
                                @Html.LabelFor(model => model.ReasonForArchiveId, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-sm-12">
                                    @Html.DropDownListFor(x => x.ReasonForArchiveId, new List<SelectListItem>(), new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.ReasonForArchiveId)
                                </div>
                            </div>

                            <button type="submit" class="btn btn-info pull-right" onclick="SubmitArchive(event)">@LayoutRES.Submit</button>
                            <button type="button" class="btn btn-default pull-left" data-dismiss="modal">@LayoutRES.Close</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

