
@model DTO.CaseFamilyBudgetDTO
@using System.Globalization;
@using Resource
@using DTO
@using UserUI.Helper
@{ 
    int t = 0;
    int m = 0;
}
<div class="modal fade" id="CaseFamilyBudgetModals" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-body">
            <div class="box box-info">
                <div class="box-header with-border">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">@CaseResources.CaseFamilyBudget</h4>
                </div><!-- /.box-header -->
                <!-- form start -->
                @if (Model.CaseFamilyBudgetDTOList.Any())
                {
                    <div class="box-body">
                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <th style="width: 10px">#</th>
                                    <th>@CaseResources.Income</th>
                                    <th>@CaseResources.Amount</th>
                                    <th>@CaseResources.Currency</th>
                                    <th>@LayoutRES.Delete</th>
                                    <th>@LayoutRES.Edit</th>
                                </tr>
                                @foreach (var com in Model.CaseFamilyBudgetDTOList.Select((value, i) => new { i, value }))
                                {
                                    if (com.value.IsIncome)
                                    {
                                        t++;
                                        <tr id="@com.value.Id">
                                            <td>@t</td>
                                            <td>@com.value.Title</td>
                                            <td>@com.value.Amount</td>
                                            <td>@com.value.CurrencyName</td>
                                            <td><i class="fa fa-times-circle-o" onclick="DeleteCaseFamilyBudget('@com.value.Id')"></i></td>
                                            <td>
                                                @if (AuthorizationHelper.UserId == com.value.CreatedBy)
                                                {
                                                    <i class="fa fa-edit" style="cursor:pointer" onclick="openEditCaseFamilyBudget('@com.value.Id')"></i>

                                                }
                                            </td>  
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="box-body">
                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <th style="width: 10px">#</th>
                                    <th>@CaseResources.OutCome</th>
                                    <th>@CaseResources.Amount</th>
                                    <th>@CaseResources.Currency</th>
                                    <th>@LayoutRES.Delete</th>
                                    <th>@LayoutRES.Edit</th>
                                </tr>
                                @foreach (var com in Model.CaseFamilyBudgetDTOList.Select((value, i) => new { i, value }))
                                {
                                    if (!com.value.IsIncome)
                                    {
                                        m++;
                                        <tr id="@com.value.Id">
                                            <td>@m</td>
                                            <td>@com.value.Title</td>
                                            <td>@com.value.Amount</td>
                                            <td>@com.value.CurrencyName</td>
                                            <td><i class="fa fa-times-circle-o" onclick="DeleteCaseFamilyBudget('@com.value.Id')"></i></td>
                                            <td>
                                                @if (AuthorizationHelper.UserId == com.value.CreatedBy)
                                                {
                                                    <i class="fa fa-edit" style="cursor:pointer" onclick="openEditCaseFamilyBudget('@com.value.Id')"></i>

                                                }
                                            </td>  
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <div class="box-body">

                    @if (AuthorizationHelper.UserIsInPrivilege((int)EnumPrivilages.EditCase))
                    {
                        using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form-horizontal", id = "AddCaseFamilyBudgetForm" }))
                        {
                            @Html.HiddenFor(x => x.CaseId)
                            <div class="form-horizontal">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.TextBoxFor(model => model.Title, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Title)
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Amount, htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.TextBoxFor(model => model.Amount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Amount)
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="col-md-6">
                                        <input type="radio" name="IsIncome" id="IsIncome" value="true" checked />
                                        <label>@CaseResources.Income</label>
                                    </div>
                                    <div class="col-md-6">
                                        <input type="radio" name="IsIncome" id="IsIncome" value="false" />
                                        <label>@CaseResources.OutCome</label>
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Currency, htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(x => x.Currency, new List<SelectListItem>(), new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Currency)
                                    </div>
                                </div>
                            </div>
                     <!-- /.box-body -->
                            <div class="box-footer">
                                <button type="submit" class="btn btn-info pull-right">@LayoutRES.Add</button>
                                <button type="button" class="btn btn-default pull-left" data-dismiss="modal">@LayoutRES.Close</button>
                            </div><!-- /.box-footer -->
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
