


@model  Components.UserManagement.DTO.ResetPasswordViewModel
@using Resource
@{
    ViewBag.Title = LayoutRES.ResetYourPassword; 
} 
<section>
    <div class="block gray">
        <div class="container">
            <div class="search-page">
                <div class="col-md-9 column">
                    <h5>@LayoutRES.ResetYourPassword</h5> 
                    @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { @class = "contact-form", role = "form", id = "ResetPasswordForm" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.Code)
                        <div class="row">
                            <div class="col-md-10">@Html.TextBoxFor(m => m.Email, new { placeholder = LayoutRES.Email })</div>
                            @Html.ValidationMessageFor(m => m.Email)
                            <div class="col-md-10">@Html.PasswordFor(m => m.Password, new { placeholder = LayoutRES.Password })</div>
                            @Html.ValidationMessageFor(m => m.Password)
                            <div class="col-md-10">@Html.PasswordFor(m => m.ConfirmPassword, new { placeholder = LayoutRES.ConfirmPassword })</div>
                            @Html.ValidationMessageFor(m => m.ConfirmPassword)
                            <div class="col-md-5">
                                <a class="theme-btn" href="javascript:{}" onclick="document.getElementById('ResetPasswordForm').submit();">@LayoutRES.Submit</a>
                            </div> 
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

