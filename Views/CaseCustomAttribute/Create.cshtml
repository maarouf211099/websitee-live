                                <input type="button" style="font-size:95%;" onclick="Update('@System.Configuration.ConfigurationManager.AppSettings["MersalWebAPIBaseUrl"]' + 'CaseCustomAttribute/UpdateAttr')" class="btn btn-info btn-block" value="@CaseCustomAtrributeRes.Save">
                            </div>
