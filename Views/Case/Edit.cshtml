@model DTO.CaseDTO

@{
    ViewBag.Title = "Edit";
    bool isArabic = UserUI.Helper.CultureHelper.GetCurrentCulture() == "ar-SA";
}

<h2>Edit</h2>
@using (Html.BeginForm("Edit", "Case", null, FormMethod.Post, new { @class = "", id = "EditForm" }))
{ 
    <div class="form-horizontal">
        <h4>CaseDTO</h4>
        <hr />
        @Html.HiddenFor(model => model.Id)

        <div class="form-group">
            @Html.LabelFor(model => model.Code, htmlAttributes: new { @class = "control-label col-md-2" })
