<script type="text/javascript">
        $(document).ready(function () {
            function onSelect(e) {
                switch ($(e.item).index()) {
                    case 1:
                        //bind Privileges
                        bindPrivileges();
                        break;
                    case 2:
                        //bind Groups
                        bindGroups();
                        break;
                    case 3:
                        //bind Roles
                        bindRoles();
                        break;
                    case 4:
                        bindMenus();
                        break;
                }
            }

            $("#tabstrip").kendoTabStrip({
                select: onSelect,
                animation: {
                    open: {
                        effects: "fadeIn"
                    }
                }
            });
        });

        function initialzeUserTabs() {
            var tabStrip = $("#tabstrip").kendoTabStrip().data("kendoTabStrip");
            tabStrip.select(0);
        }
</script>
<script type="text/javascript">
        $(function () {
            searchStores();

            $('#btnSearch_User').click(function (evt) {
                searchStores();
            });
        });

        function searchStores() {
            //var jsonObject = searchObjectBuilder.getJsonSearchObj('searchBox_User input');
            //var strJSON = JSON.stringify(jsonObject);
            $.ajax({
                url: '@ConfigurationManager.AppSettings["MersalWebAPIBaseUrl"]' + 'api/Stores/GetAllStores',
                cache: false,
                type: "POST",
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                //data: strJSON,
                success: function (data) {
                    bindStoresGrid(data);
                },
                error: function (xhr) {
                    toastr.error(xhr.statusText);
                },
                async: true,
                processData: false
            });
        }
    function RefreshStores() {
        //var jsonObject = searchObjectBuilder.getJsonSearchObj('searchBox_User input');
        //var strJSON = JSON.stringify(jsonObject);
        $.ajax({
            url: '@ConfigurationManager.AppSettings["MersalWebAPIBaseUrl"]' + 'api/Stores/GetAllStores',
            cache: false,
            type: "POST",
            dataType: 'json',
            contentType: 'application/json; charset=utf-8',
            //data: strJSON,
            success: function (data) {
                ds1 = new kendo.data.DataSource({
                    data: data
                });

                var grid = $("#InventoryItems_Grid").data("kendoGrid");
                grid.dataSource = ds1;
                ds1.read();
                grid.refresh();
            },
            error: function (xhr) {
                toastr.error(xhr.statusText);
            },
            async: true,
            processData: false
        });
    }
</script>
<script type="text/javascript">
        function bindStoresGrid(jsonData) {
            var firstDeleteRequest = 1;

            var isHidden = !$("#IsActiveUser").is(":checked");

            var commands = [{
                name: "details",
                text: "",
                iconClass: "fa fa-file-text-o fa-fw fa-2x",
                click: function (e) {
                    var tr = $(e.target).closest("tr");
                    var id = tr.find('.id-cell').text();

                    EditStore(id);
                }
            },
                   {
                       name: "delete",
                       text: "",
                       iconClass: "fa fa-trash-o fa-fw fa-2x",
                       click: function (e) {
                           var tr = $(e.target).closest("tr");
                           var id = tr.find('.id-cell').text();

                           var CallBackFunction = function () { DeleteStore(tr, id); };
                           confirmMessage("Confirmation", "are you sure you want to delete", 400, 250, CallBackFunction);

                           
                       }
                   }];

            _columns = [
                    { field: "Id", filterable: false, hidden: true, attributes: { "class": "id-cell" } },
                    { field: "Name", title: "@UserManagementResources.UserName", filterable: true },
                {
                    field: 'CountryName',
                    title: "@StoreRes.CountryId",
                    filterable: true
                },
                {
                    field: 'GovornrateName',
                    title: "@StoreRes.GovernorateId",
                    filterable: true
                },
                { field: "DistrictName", title: "@StoreRes.DistrictId", filterable: true },
                {
                    field: 'Address',
                    title: "@StoreRes.Address",
                    filterable: true
                },
                {
                    field: 'AdministratorName',
                    title: "@StoreRes.AdministratorId",
                    filterable: true

                },
                {
            title: '@LayoutRES.Manage',
            command: commands,
            width: 200
        }]

            $("#InventoryItems_Grid").html("");
            $("#InventoryItems_Grid").kendoGrid({
                groupable: false,
                scrollable: false,
                sortable: true,
                pageable: {
                    pageSize: 10,
                    refresh: true
                },
                selectable: "multiple cell",
                allowCopy: {
                    delimeter: ",",
                },
                columns: _columns,
                filterable: {
                    extra: false,
                    messages: {
                        filter: "@CommonRes.Filter", // sets the text for the "Filter" button
                        clear: "@CommonRes.Clear", // sets the text for the "Clear" button

                        // when filtering boolean numbers
                        isTrue: "@CommonRes.IsTrue", // sets the text for "isTrue" radio button
                        isFalse: "@CommonRes.IsFalse", // sets the text for "isFalse" radio button

                        //changes the text of the "And" and "Or" of the filter menu

                        and: "@CommonRes.And",
                        or: "@CommonRes.Or",
                        itemsPerPage: "@CommonRes.ItemsPerPage",
                        of: "@CommonRes.Of",
                        items: "@CommonRes.Items"

                    }
                    , operators: {
                        //filter menu for "string" type columns
                        string: {
                            EqualsTo: "@CommonRes.EqualsTo",
                            NotEqualTo: "@CommonRes.NotEqualTo",
                            StartsWith: "@CommonRes.StartsWith",
                            EndsWith: "@CommonRes.EndsWith",
                            Contain: "@CommonRes.Contain",
                            doesNotContain: "@CommonRes.DoesNotContain",
                            IsGreaterThan: "@CommonRes.IsGreaterThan",
                            IsLessThan: "@CommonRes.IsLessThan",
                            IsGreaterThanOrEqualTo: "@CommonRes.IsGreaterThanOrEqualTo",
                            IsLessThanOrEqualTo: "@CommonRes.IsLessThanOrEqualTo"
                        },

                    }
                },
                dataSource: {
                    data: jsonData,
                    schema: {
                        model: { id: "Id" }
                    }
                }
            });

        }
</script>

