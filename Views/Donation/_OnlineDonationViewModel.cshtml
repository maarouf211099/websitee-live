<script>
    $(document).ready(function () {

        const urlParams = new URLSearchParams(window.location.search);
        const param_x = urlParams.get('donationDestID');
        console.log(param_x);
        var result = {};
        var intervalId = 0;
        if (param_x != null && param_x != undefined) {
            var apiurl = MersalWebAPIBaseUrl + "api/Donation/GetDonateHierarchy?id=" + param_x;
            $.ajax({
                type: "GET",
                contentType: "application/json",
                url: apiurl,
                async: true,
                success: function (data) {
                    result = data;
                    var startTime = new Date().getTime();
                    var interval = setInterval(function () {
                        if (new Date().getTime() - startTime > 10000) {
                            clearInterval(interval);
                            return;
                        }
                        mapDropDown();
                    }, 1000);  

                   /// intervalId = setInterval(mapDropDown, 1000);
                },
                error: function (xhr) {
                    toastr.error(xhr.statusText);
                }
            });
        }
        

        function mapDropDown() {
            debugger;
            if (!$('#DonationDestinationId').val())
                $('#DonationDestinationId').val(result.DonationDestinationId).change();
            if (!$('#DonationDestinationSubId').val())
                $('#DonationDestinationSubId').val(result.DonationDestinationSubId).change();
            if (!$('#DonationDestinationSubOfSubId').val())
                $('#DonationDestinationSubOfSubId').val(result.DonationDestinationSubOfSubId);
            console.log($('#DonationDestinationId').val());
            //if ($('#DonationDestinationId').val()) {
            //    clearInterval(intervalId);
            //}

        }
        

    });

    $('#Donate10').click(function () {
        $("#mesageAmount").addClass("hidden");

        $("#AmountTextArea").attr("readonly", true).val(10);
    });

    $('#Donate50').click(function () {
        $('#mesageAmount').addClass('hidden');

        $("#AmountTextArea").attr("readonly", true).val(50);
    });

    $('#Donate100').click(function () {
        $('#mesageAmount').addClass('hidden');

        $("#AmountTextArea").attr("readonly", true).val(100);
    });

    $('#Donate500').click(function () {
        $('#mesageAmount').addClass('hidden');

        $("#AmountTextArea").attr("readonly", true).val(500);
    });

    $('#OtherAmount').click(function () {
        $("#AmountTextArea").attr("readonly", false).val('');
    });


</script>








