<script type="text/javascript">

    // this derivation fro the function is to reduce the number of requests
    function GetAnyMasterDetalisCode(MasterCode, dropDownListId, enableAll, async, selectedId) {
        $.ajax({
            type: "GET",
            async: false,
            contentType: "application/json",
            url: SystmeCodeWebAPIBaseUrl + "api/DetailCode/GetMasterCodeByMultiCode?masterCode=" + MasterCode,
            success: function (data) {
                var html = "";
                if (enableAll) {
                    if (_cultureIsArabic) {
                        html = "<option value='0'>الكل</option>";
                    }
                    else {
                        html = "<option value='0'>All</option>";
                    }
                }
                var selec = "";
                var textByIdArr = [];
                $.each(data, function (key, value) {

                    if (value.masterCodeValue == MasterCode) {
                        if (value.Id == selectedId) selec = " selected='selected' ";
                        if (_cultureIsArabic) {
                            html += "<option Code=" + value.Code + " value=" + value.Id + selec + "  >" + value.NameAr + "</option>";
                            textByIdArr[value.Id.toString()] = value.NameAr;
                        }
                        else {
                            html += "<option Code=" + value.Code + " value=" + value.Id + selec + " >" + value.NameEn + "</option>";
                            textByIdArr[value.Id.toString()] = value.NameEn;
                        }
                    }
                });
                $("#" + dropDownListId).html(html);
            },
            error: function (xhr) { 
    toastr.error(xhr.statusText);
            }
        });
    }
    function isset(variable) {
        return typeof variable !== typeof undefined ? true : false;
    }
</script>
