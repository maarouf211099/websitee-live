<script>
   
    GetAndDrawCount(MersalWebAPIBaseUrl + "api/Accounts/GetAccountCount", "accountNumber")
    function GetAndDrawCount(apiurl,Id) {
      
        $.ajax({
            type: "get",
            contentType: "application/json",
            url: apiurl,
            crossDomain: true,
            headers: getHeaders(),

            async: false,
            success: function (data) {

                $("#" + Id).html(data);
            },
            error: function (xhr) {


                toastr.error(xhr.error); 
            }
        });
    }
</script>
