    <script id="globalVaribales">
        //// the global array is 2d array
        // the main purpose of this array is to convert the id returned in the dto to text
        // the global array will have the values of the drop down list and the text
        // the first dimenssion is the array name
        // the second dimentsion is the id
        // the value of the array elements are the text whether arabic or english
        var GlobalArray = [];
        function loadGlobalVariables() {
            $.holdReady(true);
            GetAnyMasterDetalisCode('IMTY', "ddlTypeId", false, true);
            GetAnyMasterDetalisCode('IMU', "ddlUnitId", false, true);
            GetAnyMasterDetalisCode('IMPU', "ddlPackingUnitId", false, true);
            GetAnyMasterDetalisCode('IMEU', "dllExchangeUnitId", false, true);
            GetAnyMasterDetalisCode('IMC', "ddlCategoryId", false, true);
            GetAnyMasterDetalisCode('IMF', "ddlformulaId", false, true);
            $.holdReady(false);

        }

        function GetValueFromGlobalArray(arrayNameStr, id) {
           
            if (isset(GlobalArray[arrayNameStr]) && isset(GlobalArray[arrayNameStr][id]))
                return '<span>' + GlobalArray[arrayNameStr][id.toString()] + '</span>';
            else
                return '';
        }



        function LoadDDlFromGlobalArr(Array, dropDownListId, selectedId) {
            var html = "";
            var selec = "";
            var textByIdArr = [];
            
            $.each(Array, function (key, value) {
                // performance issue need to be enhanced
                // looping throgh alot of uncexisted elements 
                // for example if the key was 10000 and this key is the first
                // foreach will make tenThoutand loop
                if (value) {
                    if (parseInt(key) == selectedId) selec = " selected='selected' ";
                    if (_cultureIsArabic) {
                        html += "<option  value=" +key+ "  >" + value + "</option>";
                    }
                    else {
                        html += "<option value=" +key+  " >" + value + "</option>";
                    }
                }
            });
            $("#" + dropDownListId).html(html);
        }


    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            function onSelect(e) {
                switch ($(e.item).index()) {
                    case 1:
                        //bind Privileges
                        bindPrivileges();
                        break;
                    case 2:
                        //bind Groups
                        bindGroups();
                        break;
                    case 3:
                        //bind Roles
                        bindRoles();
                        break;
                    case 4:
                        bindMenus();
                        break;
                }
            }

            $("#tabstrip").kendoTabStrip({
                select: onSelect,
                animation: {
                    open: {
                        effects: "fadeIn"
                    }
                }
            });
        });

        function initialzeUserTabs() {
            var tabStrip = $("#tabstrip").kendoTabStrip().data("kendoTabStrip");
            tabStrip.select(0);
        }
    </script>
    <script type="text/javascript">
        $(function () {
            loadGlobalVariables();
            searchInventoryItems();          
            $('#btnSearch_User').click(function (evt) {
                searchInventoryItems();
            });
        });

        function searchInventoryItems() {
            //var jsonObject = searchObjectBuilder.getJsonSearchObj('searchBox_User input');
            //var strJSON = JSON.stringify(jsonObject);
            
            $.ajax({
                url: '@ConfigurationManager.AppSettings["MersalWebAPIBaseUrl"]' + 'api/InventoryItems/GetAllInventoryItems',
                cache: false,
                type: "POST",
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                //data: strJSON,
                success: function (data) {
                    bindInventoryItemsGrid(data);
                },
                error: function (xhr) {
                    toastr.error(xhr.statusText);
                },
                async: true,
                processData: false
            });
        }
        function RefreshInventoryItems() {
            //var jsonObject = searchObjectBuilder.getJsonSearchObj('searchBox_User input');
            //var strJSON = JSON.stringify(jsonObject);

            $.ajax({
                url: '@ConfigurationManager.AppSettings["MersalWebAPIBaseUrl"]' + 'api/InventoryItems/GetAllInventoryItems',
                cache: false,
                type: "POST",
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                //data: strJSON,
                success: function (data) {
                      
                    ds1 = new kendo.data.DataSource({
                        data: data
                    });

                    var grid = $("#InventoryItems_Grid").data("kendoGrid");
                    grid.dataSource = ds1;
                    ds1.read();
                    grid.refresh();
                },
                error: function (xhr) {
                    toastr.error(xhr.statusText);
                },
                async: true,
                processData: false
            });
        }
    </script>
    <script type="text/javascript">
        function bindInventoryItemsGrid(jsonData) {
            var firstDeleteRequest = 1;

            var isHidden = !$("#IsActiveUser").is(":checked");

            var commands = [{
                name: "details",
                text: "",
                iconClass: "fa fa-file-text-o fa-fw fa-2x",
                click: function (e) {
                    var tr = $(e.target).closest("tr");
                    var id = tr.find('.id-cell').text();

                    EditInventoryItem(id);
                }
            },
                   {
                       name: "delete",
                       text: "",
                       iconClass: "fa fa-trash-o fa-fw fa-2x",
                       click: function (e) {
                           var tr = $(e.target).closest("tr");
                           var id = tr.find('.id-cell').text();

                           var CallBackFunction = function () { DeleteInventoryItem(tr, id); };
                           confirmMessage("Confirmation", "are you sure you want to delete", 400, 250, CallBackFunction);

                           
                           

                       }
                   }];

            _columns = [
                    { field: "Id", filterable: false, hidden: true, attributes: { "class": "id-cell" } },
                    { field: "Name", title: "@UserManagementResources.UserName", filterable: true },
                {
                    template: '#=GetValueFromGlobalArray("IMC",CategoryId)#',
                    title: "@InventoryItemsRes.CategoryId",
                    filterable: true
                },
                {
                    template: '#=GetValueFromGlobalArray("IMTY",TypeId)#',
                    title: "@InventoryItemsRes.TypeId",
                    filterable: true
                },
                { field: "Concentration", title: "@UserManagementResources.UserName", filterable: true },
                {
                    template: '#=GetValueFromGlobalArray("IMU",UnitId)#',
                    title: "@InventoryItemsRes.UnitId",
                    filterable: true
                },
                {
                    template: '#=GetValueFromGlobalArray("IMF",FormulaId)#',
                    title: "@InventoryItemsRes.FormulaId",
                    filterable: true
                },
                {
                    template: '#=GetValueFromGlobalArray("IMPU",PackingUnitId)#',
                    title: "@InventoryItemsRes.PackingUnitId",
                    filterable: true
                },
                {
                    template: '#=GetValueFromGlobalArray("IMEU",ExchangeUnitId)#',
                    title: "@InventoryItemsRes.ExchangeUnitId",
                    filterable: true
                },
                { field: "PackingExchangeUnitsNumber", title: "@InventoryItemsRes.PackingExchangeUnitsNumber", filterable: true },
                { field: "Description", title: "@UserManagementResources.Description", filterable: true },
                {
                    title: "@LayoutRES.Manage",
                    command: commands,
                    width: 200
                }]

            $("#InventoryItems_Grid").html("");
            $("#InventoryItems_Grid").kendoGrid({
                groupable: false,
                scrollable: false,
                sortable: true,
                pageable: {
                    pageSize: 10,
                    refresh: false
                },
                selectable: "multiple cell",
                allowCopy: {
                    delimeter: ",",
                },
                columns: _columns,
                filterable: {
                    extra: false,
                    messages: {
                        filter: "@CommonRes.Filter", // sets the text for the "Filter" button
                        clear: "@CommonRes.Clear", // sets the text for the "Clear" button

                        // when filtering boolean numbers
                        isTrue: "@CommonRes.IsTrue", // sets the text for "isTrue" radio button
                        isFalse: "@CommonRes.IsFalse", // sets the text for "isFalse" radio button

                        //changes the text of the "And" and "Or" of the filter menu

                        and: "@CommonRes.And",
                        or: "@CommonRes.Or",
                        itemsPerPage: "@CommonRes.ItemsPerPage",
                        of: "@CommonRes.Of",
                        items: "@CommonRes.Items"

                    }
                    , operators: {
                        //filter menu for "string" type columns
                        string: {
                            EqualsTo: "@CommonRes.EqualsTo",
                            NotEqualTo: "@CommonRes.NotEqualTo",
                            StartsWith: "@CommonRes.StartsWith",
                            EndsWith: "@CommonRes.EndsWith",
                            Contain: "@CommonRes.Contain",
                            doesNotContain: "@CommonRes.DoesNotContain",
                            IsGreaterThan: "@CommonRes.IsGreaterThan",
                            IsLessThan: "@CommonRes.IsLessThan",
                            IsGreaterThanOrEqualTo: "@CommonRes.IsGreaterThanOrEqualTo",
                            IsLessThanOrEqualTo: "@CommonRes.IsLessThanOrEqualTo"
                        },

                    }
                },
                dataSource: {
                    data: jsonData,
                    schema: {
                        model: { id: "Id" }
                    }
                }
            });

        }
    </script>

