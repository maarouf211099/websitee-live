                            @if (item.CaseCount != null)
                            {
                                <h3>@item.CaseCount</h3>
                            }
                            else
                            {
                                <h3>0</h3>
                            }
                            @if (isArabic)
                            {
                                <p>@item.NameAr</p>
                            }
                            else
                            {
                                <p>@item.NameEn</p>
                            }
                        </div>
                        <div class="icon">
                            <i class="ion ion-person-add"></i>
                        </div>
                        <a href="/Case/Index?state=csNE" class="small-box-footer">@LayoutRES.GO<i class="fa fa-arrow-circle-right"></i></a>
                    </div>
                </div>
                break;
