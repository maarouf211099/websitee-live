
@model DTO.AlbumsDTO
@using Resource
@using DTO
@using UserUI.Helper
@using Kendo.Mvc.UI
@{
    bool isArabic = UserUI.Helper.CultureHelper.GetCurrentCulture() == "ar-SA";
    var KendoClass = isArabic ? "k-rtl" : "";
}
<div class="modal fade" id="AlbumDetailsModals" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-body">
            <div class="box box-info">
                <div class="box-header with-border">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">@HomeSliderResources.EditHomeSlide</h4>
                </div>
              
                <div class="box-body">
                    @using (Html.BeginForm(null, null, null, FormMethod.Post, new { @class = "", id = "DeleteAlbumForm" }))
                    {
                        @Html.HiddenFor(m => m.Id)

                        <div class="form-horizontal">
                            <div class="form-group">
                                @Html.Label("Are You Sure You want to Delete it ?", htmlAttributes: new { @class = "control-label col-md-12" })
                            </div>
                            <div class="form-group">
                                <div class="col-md-offset-2 col-md-8">
                                    @*<span class="label label-danger" style="cursor: pointer;" >@HomeSliderResources.Delete </span>*@
                                    @*<input id="btnDelete" onclick="ConfirmDeleteSlide('@Model.Id')" type="button" value="@LayoutRES.Delete" class="btn btn-default" />*@
                                    <input id="btnDelete" onclick="ConfirmDeleteSlide('@Model.Id')" type="button" value="@LayoutRES.Delete" class="btn btn-info" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
