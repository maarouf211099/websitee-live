<script id="form submit">
    function registerSearchFormSubmitting() {
        $("#frmSearchStoreOperation").submit(function (e) {
            var apiurl = MersalWebAPIBaseUrl + "api/StoreOperations/searchWithdrawPermissions";
            $.validator.unobtrusive.parse($("#frmSearchStoreOperation"))
            e.preventDefault();
            if (!$("#frmSearchStoreOperation").valid()) return;

            var data = {};
            $("#frmSearchStoreOperation").serializeArray().map(function (x) { data[x.name] = x.value; });

            console.log(JSON.stringify(data));
            $.ajax({
                type: "POST",
                contentType: "application/json",
                url: apiurl,
                crossDomain: true,
                headers: getHeaders(),
                data: JSON.stringify(data),
                async: false,
                success: function (data) {
                    ds1 = new kendo.data.DataSource({

                        data: data
                    });

                    var grid = $("#WithdrawPermissions_Grid").data("kendoGrid");
                    grid.dataSource = ds1;
                    ds1.read();
                    grid.refresh();
                },
                error: function (xhr) {
                    $('#AddCaseModals').modal('hide');
                    toastr.error('@InventoryItemsRes.OperationFailed '); 
                }
            });
        });

    };
    registerSearchFormSubmitting();
</script>
