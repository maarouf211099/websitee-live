@model IEnumerable<DTO.getCasesOverViewDTO>
@using Resource
@using UserUI.Helper
@using DTO
@{
    ViewBag.Title = LayoutRES.Admin;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    bool isArabic = UserUI.Helper.CultureHelper.GetCurrentCulture() == "ar-SA";
    var floatToRight = (CultureHelper.IsRighToLeft() ? "floatToRight" : "");
    var textAlignRight = isArabic ? "text-align: right;" : "";
    var dir = isArabic ? "rtl" : "ltr";
}
@if ((AuthorizationHelper.UserIsInPrivilege((int)EnumPrivilages.ViewCasesList)) && Model != null)
{
    foreach (var item in Model)
