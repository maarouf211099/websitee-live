        </div>
    </div>
}
 

<script>
 
    function GetCaseCategory() {

        var id = $("#CaseCategory").val();

        if (id != "") {
            return id; 
        }
        else {
            return -1;
        }
    }


    BindGrid()
    function BindGrid() {
        $("#Grid").html('')
         var url = '@System.Configuration.ConfigurationManager.AppSettings["MersalWebAPIBaseUrl"]' + "CaseCustomAttribute/GetCustomAttrByCaseCategoryId?CaseCategory=" + GetCaseCategory();
        var dataSource = new kendo.data.DataSource({
            transport: {
                read: {
                    url: url,
                    dataType: "json"
                },
                parameterMap: function (options, type) {

                    try {
                        var result = {
                            take: options.take,
                            skip: options.skip
                        };

                        if (options.sort) {
                            for (var i = 0; i < options.sort.length; i++) {
                                result["sort[" + i + "].field"] = options.sort[i].field;
                                result["sort[" + i + "].dir"] = options.sort[i].dir;
                            }
                        }


                        if (options.filter != "" && options.filter != undefined) {
                            if ('filter' in options && options.filter.filters.length > 0) {
                                result["filter"] = options.filter;
                            }
                        }


                        return result;

                    } catch (e) { 
                        toastr.error(e.statusText);
                    }
                },
            },
            schema: {
                total: function (data) {
                    return data.Total;

                },
                data: function (data) {
                    return data.Data;
                },
            },
            type: "json",
            pageSize: 10,
            serverPaging: true,
            serverFiltering: true,
            serverSorting: true
        });
        $("#Grid").kendoGrid({
            dataSource: dataSource,
            // height: 550, 
            groupable: {
                messages: {
                    empty: DragaColumnHeaderAndDropItHereToGroupByThatColumn,
                }
            },
            sortable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [{
                field: "AttributeName",
                title: "@CaseCustomAtrributeRes.Property"
            }, {
                field: "AttributeDescription",
                title: "@CaseCustomAtrributeRes.description"
            },
            {
                filterable: false,
                sortable: false,
                title: '@LayoutRES.Edit',
                template: "<div class='text-center'><a style='cursor: pointer;color: \\#428bca!important' onclick=getEdit(#=ID#)><i class='fa fa-file-text-o fa-fw fa-2x'></i></a></div>"

            },
            {
                filterable: false,
                sortable: false,
                title: '@LayoutRES.Delete',
                template: "<div class='text-center'><a style='cursor: pointer;color: \\#428bca!important' onclick=getDelete(#=ID#)><i class='fa fa-trash-o fa-fw fa-2x'></i></a></div>",

            }, ]
        });
    }
    $('[data-datepicker]').kendoDatePicker({
        culture: "ar-EG",

        format: "{0:yyyy-MM-dd}"
    });
    function GetValidateInput() {
        $('.validate').hide('slow')
        $('.validate :input').val('')
  .removeAttr('checked')
  .removeAttr('selected');
        var DataTypeId = $("#DataTypeId").val();
        if (DataTypeId == '@StaticIDs.DataTypeINT' || DataTypeId == '@StaticIDs.DataTypeFloat') {
            $('#IntDiv').show('slow')
        } else if (DataTypeId == '@StaticIDs.DataTypeString') {
            $('#StringDiv').show('slow')
        } else if (DataTypeId == '@StaticIDs.DataTypeDate') {

            $('#DateDiv').show('slow')

        }
        else if (DataTypeId == lookupID) {
            $('#LookUpDiv').show('slow')

        }


    }
    var lookupID = '@StaticIDs.LOKUP';
    var successMsg = '@CaseCustomAtrributeRes.SuccessaddOperation';
    var ErrorMsg = '@CaseCustomAtrributeRes.ErrorOperation';
    var IdDelete = 0;
    var CategoryMasterCodeID = '@StaticIDs.CategoryMasterCodeID';

    var updatedobject = {};

    function getEdit(id) {
        url = '@System.Configuration.ConfigurationManager.AppSettings["MersalWebAPIBaseUrl"]' + 'CaseCustomAttribute/GetById' + '?id=' + id;
        $.ajax({
            url: url,
            type: 'get',
            //data: { entity: jsonDTo },
            success: function (res) {
                updatedobject = res;

                $("#btnAdd").hide()
                $("#btnUpdate").show()

                $('#Property').val(res.AttributeName)
                $('#AttributeDescription').val(res.AttributeDescription)


                $("#DataTypeId").data("kendoComboBox").value(res.DataTypeId);
                GetValidateInput()
                $("#MinLength").val(res.MinLength)
                $("#MaxLength").val(res.MaxLength)
                $("#MaxValue").val(res.MaxValue)
                $("#MinValue").val(res.MinValue)
                $("#MasterCodeID").val(res.MasterCodeID)


                if (res.IsRequired) {
                    //$("#IsRequired").checked = true;
                    //$('#IsRequired').prop('checked', true);
                    $('#IsRequired').attr('checked', true);


                }
                else {
                    $('#IsRequired').attr('checked', false);

                }

            }
        })

    };


</script>


