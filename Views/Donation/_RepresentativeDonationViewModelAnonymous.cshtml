</div>

<script>
    $('#EmailAnonymous').on("keypress", function (e) {
        $(this).val($(this).val().trim());
        if (e.which === 32)
            return false;
    });

    $('#EmailAnonymous').on("blur", function (e) {
        $(this).val($(this).val().trim());
    });
