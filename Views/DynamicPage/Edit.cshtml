@using DTO
@using Resource
@model DynamicPagesDTO
@using Kendo.Mvc.UI
@using UserUI.Helper
@{
    ViewBag.Title = DynamicPagesRES.Edit;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    bool isArabic = CultureHelper.GetCurrentCulture() == "ar-SA";
    var KendoClass = isArabic ? "k-rtl" : "";
}
<script src="~/Scripts/TextEditor/ckeditor/ckeditor.js"></script>
<div class="box box-info">
    <!-- /.box-header -->
    <!-- form start -->
    <div class="box-body">


        <!-- general form elements -->
        <!-- form start -->
        <form role="form" id="CreateDynamicPage">
            <div class="box-body">
                <div class="row">

                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Name)
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Name)
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Link</label>
                            <input id="LinkOfPage" class="form-control" onkeypress="return false" />
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.TitleAR)
                            @Html.TextBoxFor(m => m.TitleAR, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.TitleAR)
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.TitleEN)
                            @Html.TextBoxFor(m => m.TitleEN, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.TitleEN)
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        @Html.LabelFor(m => m.TypeId)
                        @Html.DropDownListFor(m => m.TypeId, new List<SelectListItem>(), new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.TypeId)
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="demo-section k-content @KendoClass ">
                            @(Html.Kendo().Upload()
                                    .Name("Image")
                                    .Messages(m => m.Select(AlbumResource.Image).UploadSelectedFiles(LayoutRES.Submit))
                                    .TemplateId("fileTemplate")
                                    .HtmlAttributes(new { accept = "image/*" })
                                    .Multiple(false)
                                    .Async(a => a
                                    .Save("CreatePage", "DynamicPages")
                                    .AutoUpload(false))
                                    .Events(c => c
                                    .Upload("onUploadImageCreate").Success("onSuccessUploadDataCreate")
                                    .Select("onSelectImage")
                                    )
                        )
                            @Html.ValidationMessageFor(model => model.Image)
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            @Html.LabelFor(m => m.ContentAR)
                            <div class="box-body pad">
                                @*<textarea id="ContentAR" class="textarea" placeholder="...." style="width: 100%; height: 200px; font-size: 14px; line-height: 18px; border: 1px solid #dddddd; padding: 10px;"></textarea>*@
                                @Html.TextAreaFor(m => m.ContentAR, new { @class = "textarea", @placeholder = "....", @style = "width: 100%; height: 200px; font-size: 14px; line-height: 18px; border: 1px solid #dddddd; padding: 10px;" })
                            </div>


                        </div>
                    </div>
                    @Html.ValidationMessageFor(m => m.ContentAR)


                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            @Html.LabelFor(m => m.ContentEn)
                            <div class="box-body pad">
                                @*<textarea id="ContentAR" class="textarea" placeholder="...." style="width: 100%; height: 200px; font-size: 14px; line-height: 18px; border: 1px solid #dddddd; padding: 10px;"></textarea>*@
                                @Html.TextAreaFor(m => m.ContentEn, new { @class = "textarea", @placeholder = "....", @style = "width: 100%; height: 200px; font-size: 14px; line-height: 18px; border: 1px solid #dddddd; padding: 10px;" })
                            </div>


                        </div>
                    </div>
                    @Html.ValidationMessageFor(m => m.ContentEn)


                </div>
            </div>
            <div class="box-footer" style="float:left;">
                <button type="button" onclick="EditePage()" class="btn btn-info">@DynamicPagesRES.save</button>
                <a href="@Url.Action("index")" class="btn btn-default">@LayoutRES.Close</a>
            </div>

        </form>
    </div>
</div>

<script>



    function getDynamicContentTypes() {
        $.ajax({
            type: "GET",
            contentType: "application/json",
            url: MersalWebAPIBaseUrl + "api/DynamicPages/GetDynamicContentTypes",
            async: true,
            beforeSend: function () {
                $("#imgAjaxLoader").show();
            },
            success: function (data) {
                $("#imgAjaxLoader").hide();
                var htmlParentAccount = "<option value='' selected=\"\" ></option>";
                $.each(data, function (key, value) {
                    htmlParentAccount += "<option value=" + value.Id + "   >" + value.NameAR + "</option>";
                });
                $("#TypeId").html(htmlParentAccount);
            },
            error: function (xhr) {
                $("#imgAjaxLoader").hide();
                toastr.error(xhr.statusText);
            }
        });
    }

    function onUploadImageCreate(e) {
        var myForm = $("#CreateDynamicPage");
        if (!myForm.valid()) {
            $("#Image").data("kendoUpload").trigger("cancel");
            e.preventDefault();
            return;
        };
        var data = {};
        $("#CreateDynamicPage").serializeArray().map(function (x) { data[x.name] = x.value; });
        e.data = data;
    }

    function onSuccessUploadDataCreate(e) {
        toastr.success(SuccessfulProcess);
        document.getElementById("CreateDynamicPage").reset();
    }

    var image;
    var imageName;

    function onSelectImage(e) {
        imageName = e.files[0].rawFile.name;
        fileToBase64(e.files[0].rawFile);
        setTimeout(function () { $(".k-upload-selected").hide(); }, 1);
        $(".field-validation-error").html("");
    }

    function fileToBase64(file) {
        const reader = new FileReader();
        reader.addEventListener("load", function () {
            image = reader.result;
        }, false);

        if (file) {
            reader.readAsDataURL(file);
        }
    }

    CKEDITOR.replace('ContentAR');
    CKEDITOR.replace('ContentEn');

    function updateValue(id, value) {
        document.getElementById(id).value = value;
    }


    getDynamicContentTypes();

    var EditObject = {};
    function GetBindData() {
        debugger;
        var Id = getUrlParameter('Id');
        var apiurl = MersalWebAPIBaseUrl + "api/DynamicPages/GetPageById?Id=" + Id;
        $.ajax({
            type: "get",
            contentType: "application/json",
            url: apiurl,
            crossDomain: true,
            headers: getHeaders(),

            //async: false,
            success: function (data) {
                debugger;
                EditObject = data;
                //$("#ContentAR").val(data.ContentAR)
                //$("#ContentEn").val(data.ContentEn)
                $("#Name").val(data.Name);
                $("#TitleAR").val(data.TitleAR);
                $("#TitleEN").val(data.TitleEN);
                CKEDITOR.instances.ContentAR.setData(data.ContentAR);
                CKEDITOR.instances.ContentEn.setData(data.ContentEn);
                $("#LinkOfPage").val("/DynamicPage/RenderPage?id=" + Id);
                if (data.TypeId != null) $("#TypeId").val(data.TypeId.toString());
            },
            error: function (xhr) {


                toastr.error(xhr.error);
            }
        });
    }
    GetBindData();
    function EditePage() {
        var dataAr = CKEDITOR.instances.ContentAR.getData();
        var dateEn = CKEDITOR.instances.ContentEn.getData();
        $("#ContentAR").val(dataAr);
        $("#ContentEn").val(dateEn);
        var myForm = $("#CreateDynamicPage");
        if (!myForm.valid()) return;
        var apiurl = MersalWebAPIBaseUrl + "api/DynamicPages/UpdatePage";

        EditObject.Name = $("#Name").val();
        EditObject.TitleAR = $("#TitleAR").val();
        EditObject.TitleEN = $("#TitleEN").val();
        EditObject.TypeId = $("#TypeId").val();
        EditObject.Image = image;
        EditObject.ImageName = imageName;
        EditObject.ContentAR = dataAr;// $("#ContentAR").val(),
        EditObject.ContentEn = dateEn;//$("#ContentEn").val(),


        $.ajax({
            type: "POST",
            contentType: "application/json",
            url: apiurl,
            crossDomain: true,
            headers: getHeaders(),
            data: JSON.stringify(EditObject),
            async: false,
            success: function (data) {
                if (data > 0) {
                    toastr.success(SuccessfulProcess);
                }
                else {
                    toastr.error(Error);
                }
            },
            error: function (xhr) {
                toastr.error(xhr.error);
            }
        });

    }


</script>