                                    .DataValueField("Value")
                                    .Placeholder(CaseCustomAtrributeRes.SelectCategory)
                                    .HtmlAttributes(new { style = "width:100%", @aria_required = "true" })
                                    .Filter(FilterType.Contains)
                                    .Suggest(true)
                                    .Events(e => e.DataBound("Design")
                                    .Open("Design")
                                    .Change("GetValidateInput"))
                                    .HighlightFirst(true)
                                    .DataSource(source => { source.Custom()
