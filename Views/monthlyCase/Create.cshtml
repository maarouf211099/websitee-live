@model CasesMonthlyRequestDTO
@using System.Configuration
@using UserUI.Helper
@using Resource
@using DTO
@{
    ViewBag.Title = CaseResources.MonthlyCases;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    bool isArabic = UserUI.Helper.CultureHelper.GetCurrentCulture() == "ar-SA";
    var floatToRight = (CultureHelper.IsRighToLeft() ? "floatToRight" : "");
    var textAlignRight = isArabic ? "text-align: right;" : "";
    var dir = isArabic ? "rtl" : "ltr";
} 
<div class="form-group col-sm-6 @floatToRight">
    <label class="col-md-6 control-label">@CaseResources.Cases : @LayoutRES.UncompletedCase </label>
</div>
<br />
<br />


<input id="IsFilters" type="hidden" value="NoFilter" />
<div id="panelGrid" class="form-horizontal">
    <div id="grid" class="@(CultureHelper.IsRighToLeft() ? "k-rtl" : "")"></div>
</div>
<script class="slotsTemplate" type="text/x-kendo-tmpl">
    <input class="numeric" type="number" step="1" min="0" />
</script>
<script class="textTemplate" type="text/x-kendo-tmpl">
    <textarea class="text"  rows="2" cols="22"></textarea>
</script>
