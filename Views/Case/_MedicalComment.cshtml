
@model DTO.CaseMedicalCommentDTO
@using System.Globalization;
@using Resource
@using DTO
@using UserUI.Helper

<div class="modal fade" id="MedicalCommentModals" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-body">
            <div class="box box-info">
                <div class="box-header with-border">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    @*<h4 class="modal-title">Case Comment - @Html.DisplayFor(m => m.CaseName)</h4>*@
                    <h4 class="modal-title">@CaseResources.MedicalComments</h4>
                </div><!-- /.box-header -->
                <!-- form start -->
                <div class="box-body AccordionDiv">
                    @if (Model != null)
                    {

                        if (Model.HasComment)
                        {
                            if (Model.MedicalCommentDTOList.Any())
                            {
                                foreach (var comment in Model.MedicalCommentDTOList)
                                {
                                    <h3>
                                        @comment.UserName  - @comment.CreatedOn.ToString("d/M/yyyy HH:mm", CultureInfo.InvariantCulture)
                                    </h3>
                                    <div>@comment.Comment</div>
                                    <br />

                                }
                            }
                        }
                        if (AuthorizationHelper.UserIsInPrivilege((int)EnumPrivilages.AddMedicalComments))
                        {
                            using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form-horizontal", id = "AddMedicalCommentForm" }))
                            {
                                @Html.HiddenFor(x => x.CaseId)
                     <!-- /.box-body -->
                                <div class="box-footer">
                                    <div class="form-group">
                                        @*<label class="col-sm-3 control-label">@Html.DisplayNameFor(m => m.Comment)</label>*@
                                        <div class="col-sm-12">
                                            @Html.TextBoxFor(m => m.Comment, "", new { @class = "form-control", placeholder = Html.DisplayNameFor(m => m.Comment) })
                                            @Html.ValidationMessageFor(m => m.Comment)
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-info pull-right">@CaseResources.Comment</button>
                                    <button type="button" class="btn btn-default pull-left" data-dismiss="modal">@LayoutRES.Close</button>
                                </div><!-- /.box-footer -->
                            }
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $(".AccordionDiv").accordion({
            collapsible: true,
            active: true,
            header: "h3",
            heightStyle: "content",
        });
    });
</script>