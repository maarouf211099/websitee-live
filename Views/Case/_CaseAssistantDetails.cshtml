

@model DTO.CaseAssistantDetailsDTO
@using System.Globalization;
@using Resource
@using DTO
@using UserUI.Helper
@{ 
    decimal total = 0;
}
<div class="modal fade" id="CaseAssistantDetailsModals" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-body">
            <div class="box box-info">
                <div class="box-header with-border">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">@CaseResources.CaseAssistantDetails</h4>
                </div><!-- /.box-header -->
                <!-- form start -->
                <div class="box-body">
                    @if (Model.CaseAssistantDetailsDTOList.Any())
                    {
                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <th style="width: 10px">#</th>
                                    <th>@CaseResources.Name</th>
                                    <th>@CaseResources.Description</th>
                                    <th>@CaseResources.Periode</th>
                                    <th>@CaseResources.Amount</th>
                                    <th>@CaseResources.Currency</th>
                                    <th>@LayoutRES.Delete</th>
                                </tr>
                                @foreach (var Assist in Model.CaseAssistantDetailsDTOList.Select((value, i) => new { i, value }))
                                {
                                    total += (decimal)Assist.value.Amount;
                                    <tr id="@Assist.value.Id">
                                        <td>@(Assist.i + 1)</td>
                                        <td>@Assist.value.Title</td>
                                        <td>@Assist.value.Description</td>
                                        <td>@Assist.value.Periode</td>
                                        <td>@Assist.value.Amount</td>
                                        <td>@Assist.value.CurrencyName</td>
                                        <td><i class="fa fa-times-circle-o" onclick="DeleteCaseAssistantDetails('@Assist.value.Id')"></i></td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th>@CaseResources.Total</th>
                                    <th>@total</th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    }
                </div> 
                <div class="box-body">
                    @if (AuthorizationHelper.UserIsInPrivilege((int)EnumPrivilages.EditCase))
                    {
                        using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form-horizontal", id = "AddCaseAssistantDetailsForm" }))
                        {
                            @Html.HiddenFor(x => x.CaseId)
                            <div class="form-horizontal">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.TextBoxFor(model => model.Title, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Title)
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.TextBoxFor(model => model.Description, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Description)
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Periode, htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.TextBoxFor(model => model.Periode, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Periode)
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Amount, htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.TextBoxFor(model => model.Amount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Amount)
                                    </div>
                                </div>
                                <div class="form-group"> 
                                    @Html.LabelFor(model => model.Currency, htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(x => x.Currency, new List<SelectListItem>(), new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Currency)
                                    </div>
                                </div>
                            </div>
                     <!-- /.box-body -->
                            <div class="box-footer">
                                <button type="submit" class="btn btn-info pull-right">@LayoutRES.Add</button>
                                <button type="button" class="btn btn-default pull-left" data-dismiss="modal">@LayoutRES.Close</button>
                            </div><!-- /.box-footer -->
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

