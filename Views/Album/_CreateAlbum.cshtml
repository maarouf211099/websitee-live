@model DTO.AlbumsDTO
@using Resource
@using DTO
@using UserUI.Helper
@using Kendo.Mvc.UI
@{
    bool isArabic = UserUI.Helper.CultureHelper.GetCurrentCulture() == "ar-SA";
    var KendoClass = isArabic ? "k-rtl" : "";
}

<div class="modal fade" id="CreateAlbumModals" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-body">
            <div class="box box-info">
                <div class="box-header with-border">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    @*<h4 class="modal-title">@AlbumResource.CreateAblum</h4>*@
                </div> 
                <div class="box-body">
                    @using (Html.BeginForm(null, null, null, FormMethod.Post, new { @class = "", id = "CreateAlbumForm" }))
                    {
                        @Html.HiddenFor(x=>x.AlbumId)
                        <div class="form-horizontal">
                            <div class="form-group">
                                @Html.LabelFor(model => model.TitleEn, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.TextBoxFor(model => model.TitleEn, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.TitleEn)
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.TitleAr, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.TextBoxFor(model => model.TitleAr, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.TitleAr)
                                </div>
                            </div>  
                            <div class="demo-section k-content @KendoClass ">
                                @(Html.Kendo().Upload()
                                    .Name("Image")
                                     .Messages(m => m.Select(AlbumResource.Image).UploadSelectedFiles(LayoutRES.Submit))
                                    .TemplateId("fileTemplate")
                                    .HtmlAttributes(new { accept = "image/*" ,id="CreateAlbumeUploadImage"})
                                    .Multiple(false)
                                    .Async(a => a
                                    .Save("CreateAlbum", "Album")
                                    .AutoUpload(false))
                                    .Events(c => c
                                    .Upload("onUploadAlbumImageCreate").Success("onSuccessUploadDataCreate"))
                                )
                                @Html.ValidationMessageFor(model => model.ImagePath)
                            </div> 
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
