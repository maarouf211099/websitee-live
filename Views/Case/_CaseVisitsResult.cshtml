@model IEnumerable<DTO.CaseVisiteDTO>
@using Resource
@using UserUI.Helper
@using System.Globalization

<div class="modal fade" id="CaseVisitResultListModals" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-body">
            <div class="box box-info">
                <div class="box-header with-border">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">@CaseResources.VisitResult</h4>
                    <input type="hidden" id="myCaseId" value="@ViewBag.caseId" />
                </div><!-- /.box-header -->
                <!-- form start -->
                <div class="box-body AccordionDiv">
                    @if (Model.Any())
                    {
                        foreach (var visit in Model)
                        {
                            if (visit.FileData.Any())
                            {
                                int i = 0;
                                <h3>
                                    @visit.VisitorName  - @visit.VisitDate.ToString("d/M/yyyy", CultureInfo.InvariantCulture)
                                </h3>
                                <div>
                                    <div>
                                        @visit.VisitResult
                                    </div>
                                    <div>
                                        @Html.Label(CaseResources.ServiceType) :
                                        @visit.VisiteServiceS
                                    </div>
                                    <div>
                                        @Html.Label(CaseResources.DisesaseType) :
                                        @visit.VisiteDisesaseS
                                    </div>
                                    <div>
                                        <br>
                                        @if (visit.FileData.Any())
                                        {
                                            <table class="table table-bordered">
                                                <tbody>
                                                    <tr>
                                                        <th style="width: 10px">#</th>
                                                        <th style="text-align: center;">@CaseResources.FileName</th>
                                                    </tr>

                                                    @foreach (var item in visit.FileData)
                                                    {
                                                        i++;
                                                        <tr>
                                                            <td>@i</td>
                                                            <td>
                                                                <a href="/Case/getFile?caseId=@visit.CaseId&FileName=@item.FileName">@item.FileName</a>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                    </div>

                                </div>
                            }
                        }
                    }

                </div>
                <div class="box-body" id="CaseVisitResultText">
                    @if (Model.Any())
                    {
                        foreach (var visit in Model)
                        {
                            <div id="@visit.Id">
                                <h4>
                                    @visit.VisitorName  - @visit.VisitDate.ToString("d/M/yyyy", CultureInfo.InvariantCulture)
                                </h4>
                                <div>
                                    @visit.VisitResult
                                </div>
                                <div>
                                    @Html.Label(CaseResources.ServiceType) :
                                    @visit.VisiteServiceS
                                </div>
                                <div>
                                    @Html.Label(CaseResources.DisesaseType) :
                                    @visit.VisiteDisesaseS
                                </div>
                                <div>
                                    @if (AuthorizationHelper.UserId == visit.CreatedBy)
                                    {
                                        <a class="btn btn-primary" style="cursor:pointer" onclick="GetEditCaseVisiteFull('@visit.CaseId', '@visit.Id')">@LayoutRES.Edit</a>
                                        <a class="btn btn-danger" style="cursor:pointer" onclick="DeleteCaseVisit('@visit.Id')">@LayoutRES.Delete</a>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="box-footer">
                    <button type="button" class="btn btn-info pull-right" onclick="copyToClipboard2(document.getElementById('CaseVisitResultText'))">Copy</button>
                    <button type="button" class="btn btn-default pull-left" data-dismiss="modal">@LayoutRES.Close</button>
                </div><!-- /.box-footer -->
            </div>
        </div>
    </div>
</div>




<script>
    $(document).ready(function () {
        $(".AccordionDiv").accordion({
            collapsible: true,
            active: true,
            header: "h3",
            heightStyle: "content",
        });
    });
</script>