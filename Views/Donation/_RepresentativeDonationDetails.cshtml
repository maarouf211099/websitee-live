        GetAnyMasterDetalisCode('TypeAddress', 'TypeAddressId', false, true, "", "", true,'@DonationResources.TypeAddressId');

        GetAnyMasterDetalisCode('DoDs', 'DonationDestinationRepresentativeId', false, true, "", "", true ,'@DonationResources.DonationDestination');
        GetByParentId('RegionId', model.CountryId, 'Region', '@DonationResources.Region');
        
    $('#TypeAddressId').change(function () {
        var code = this.options[this.selectedIndex].getAttribute('Code');
        if (code == "Other") {
            $('#TypeAddress').show();

        }
        else {
            $('#TypeAddress').hide();
        }


    });



    $('#CountryId').change(function () {
        //$('#Region').hide();
        $('#RegionId').html('');

        //$("#RegionId").rules("add", {
        //    required: true,
        //    messages: {
        //        required: requiredDonationDestination
        //    }
        //});
        var code = this.options[this.selectedIndex].getAttribute('Code');
        if (code == "Other") {
            //$('#Region').hide();
            $('#CountryName').show();

        }
        else {
            //$('#Region').show();
            $('#CountryName').hide();
            var id = $('#CountryId').val();
            GetByParentId('RegionId', id, 'Region','@DonationResources.Region');
        }
    });


