@model IEnumerable<DTO.CaseInvestigatorDTO>
@using Resource
@using System.Globalization
@using Kendo.Mvc.UI 

<div class="modal fade" id="AssginCaseToInvestigatorModals" role="dialog">
    <div class="modal-dialog">
        <div class="modal-body">
            <div class="box box-info">


                <div class="box-header with-border">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">@CaseResources.AssginToInvestigator</h4>
                </div><!-- /.box-header -->
                <form class="form-horizontal" id="frmAssginCaseToInvestigetor">
                    <div class="box-body">
                        <input id="CaseInvestigtor_CaseId" type="hidden" name="CaseId" value="@Model.First().CaseId" />
                        <input id="CaseInvestigtor_InvestigtorId" type="hidden" name="UserId" value="0" />
                        <input id="CaseInvestigtor_InvestigtorEmail" type="hidden" name="Email" value="" />
                        <input id="isExptionInvestigation" type="hidden" name="IsException" />
                        @if (Model.First().UserId != 0)
                        {
                            foreach (var caseInvest in Model)
                            {
                                if (caseInvest.IsDone)
                                {
                                    if (caseInvest.UpdatedOn.HasValue)
                                    {
                                        <label>@caseInvest.InvestigatorName - @LayoutRES.Done - @caseInvest.UpdatedOn.Value.ToString("d/M/yyyy HH:mm", CultureInfo.InvariantCulture)</label>
                                    }
                                    else
                                    {
                                        <label>@caseInvest.InvestigatorName - @LayoutRES.Done</label>
                                    }
                                }
                                else if (caseInvest.IsDeleted)
                                {
                                    if (caseInvest.UpdatedOn.HasValue)
                                    {
                                        <label>@caseInvest.InvestigatorName - @CaseResources.Removed - @caseInvest.UpdatedOn.Value.ToString("d/M/yyyy HH:mm", CultureInfo.InvariantCulture)</label>
                                    }
                                    else
                                    {
                                        <label>@caseInvest.InvestigatorName - @CaseResources.Removed </label>
                                    }
                                }
                                else
                                {
                                    <label>@caseInvest.InvestigatorName - @CaseResources.ActiveNow</label>
                                }
                                <br />
                            }
                        }
                        <div class="form-group">
                            <div class="col-md-8">
                                @Html.Label(CaseResources.SearchForInvestegetor, new { @class = "control-label" })
                                @(Html.Kendo().ComboBox()
                                    .Name("SearchForInvestegetor")
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    //.Placeholder(CaseCustomAtrributeRes.SelectCategory)
                                    .HtmlAttributes(new { style = "width:100%", @aria_required = "true" })
                                    .Filter(FilterType.Contains)
                                    .Suggest(true)
                                    .Events(e => e
                                    //.DataBound("SetInvestegatorData")
                                    //.Open("SetInvestegatorData")
                                    .Select("SetInvestegatorData")
                                    .Change("SetInvestegatorData")
                                    )
                                    .HighlightFirst(true)
                                    .DataSource(source =>
                                    {
                                        source.Custom()
                                       .ServerFiltering(true).ServerPaging(true).Type("aspnetmvc-ajax")
                                       .Transport(transport =>
                                       {
                                           transport.Read(r => r.Action("GetAllInvestigatorKendo", "Case") // .Data("DateTypeId")
                                           );
                                       })
                                       .Schema(schema => { schema.Data("Data").Total("Total"); });
                                    }))
                            </div>
                        </div>
                        @*<div class="form-group">
                                <div class="col-sm-12">
                                    <input type="text" id="txtSearchInvestigetor" placeholder="@CaseResources.SearchForInvestegetor" class="form-control" />
                                    <label id="MassageCaseInvestegator"></label>
                                </div>
                            </div>

                            <div id="InvestegetorUser" class="col-md-3 sidebar column">
                                <div class="widget" style="min-height:250px;">
                                    <ul id="ListOfUserUL" class="todo-list" style="width:400px;"></ul>
                                </div>
                            </div>*@
                    </div>
                    <div class="box-footer">
                        <input id="btnAssginInvestigetro" type="submit" value="@LayoutRES.Submit" class="btn btn-info pull-right" />
                        <button type="button" data-dismiss="modal" class="btn btn-default pull-left">@LayoutRES.Close</button>
                    </div><!-- /.box-footer -->
                </form>

            </div>
        </div>
    </div>
</div>
