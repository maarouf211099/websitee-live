</script>

<div id="ConfirmSave" class="modal fade" tabindex="-1" role="dialog" style="background-color: rgba(0, 0, 0, .7);" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-body">
                <h3>
                    @CaseCustomAtrributeRes.SaveMessage
                </h3>

            </div>
            <div class="modal-footer">

                <button type="button" class="btn btn-primary" id="btnCreate" onclick="addRow('@System.Configuration.ConfigurationManager.AppSettings["MersalWebAPIBaseUrl"]' + 'CaseCustomAttribute/create')">@CaseCustomAtrributeRes.Save</button>
                <button type="button" class="btn btn-primary" hidden id="btnDelete" onclick="SoftDelete('@System.Configuration.ConfigurationManager.AppSettings["MersalWebAPIBaseUrl"]' + 'CaseCustomAttribute/delete',true)">@CaseCustomAtrributeRes.Save</button>

                <button type="button" class="btn btn-default" onclick="hideConfirm()">@CaseCustomAtrributeRes.Cancel</button>

            </div>
        </div>
    </div>

</div>
