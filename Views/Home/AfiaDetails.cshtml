
@using Resource
@using DTO
@model DTO.SearchModelAfiaDetails
@using UserUI.Helper
@using Resource



<section class="section">
    <div class="container">
        <div class="content-sector">
            <h2>
                @Resource.Afia.MasterAfiaRES.AfiaCard
            </h2>
            <div class="searchOptions">
                <h3>أدخل بيانات البحث</h3>
                <div class=" row  mt-4 m-auto">
                    @if (CultureHelper.IsRighToLeft())
                    {
                        <form class="" id="SearchAfiaFormrtl">

                            <div class="col-md-4">
                                @Html.DropDownListFor(x => x.MasterId, new List<SelectListItem>(), new { @Id = "MasterAfiaId", @class = "MasterAfia drop-dwn form-control" })

                            </div>
                            <div class="col-md-4">
                                @Html.DropDownListFor(m => m.specialtyId, new List<SelectListItem>(), new { @Id = "subspecialty", @class = "form-control drop-dwn subspecialty", placeholder = @Resource.Afia.DetailAfiaRES.Specialization })

                            </div>


                            <div class="col-md-4">
                                @Html.TextBoxFor(m => m.Provider, new { @class = "form-control drop-dwn", placeholder = @Resource.Afia.DetailAfiaRES.Provider })

                            </div>
                            <div class="col-md-4">
                                @Html.DropDownListFor(m => m.GovermentId, new List<SelectListItem>(), new { @Id = "goverments", @class = "form-control drop-dwn goverments", placeholder = @Resource.Afia.DetailAfiaRES.city })

                            </div>
                            <div class="col-md-4">
                                @Html.DropDownListFor(m => m.RegionId, new List<SelectListItem>(), new { @Id = "Region", @class = "form-control drop-dwn Region", placeholder = @Resource.Afia.DetailAfiaRES.city })

                            </div>

                            <div class="col-md-4">
                                @Html.TextBoxFor(m => m.Address, new { @class = "form-control drop-dwn", placeholder = @Resource.Afia.DetailAfiaRES.Address })


                            </div>


                            <div class="col-md-12">

                                <button type="submit" class="searchBtn btn">@LayoutRES.search</button>
                            </div>
                        </form>

                    }
                    @if (!CultureHelper.IsRighToLeft()) { 
                        <form class="" id="SearchAfiaFormltr">

                            <div class="col-md-4">
                                @Html.DropDownListFor(x => x.MasterId, new List<SelectListItem>(), new { @Id = "MasterAfiaId", @class = "MasterAfia drop-dwn form-control" })

                            </div>
                            <div class="col-md-4">
                                @Html.DropDownListFor(m => m.specialtyId, new List<SelectListItem>(), new { @Id = "subspecialty", @class = "form-control drop-dwn subspecialty", placeholder = @Resource.Afia.DetailAfiaRES.Specialization })

                            </div>


                            <div class="col-md-4">
                                @Html.TextBoxFor(m => m.Provider, new { @class = "form-control drop-dwn", placeholder = @Resource.Afia.DetailAfiaRES.Provider })

                            </div>

                            <div class="col-md-4">
                                @Html.DropDownListFor(m => m.GovermentId, new List<SelectListItem>(), new { @Id = "goverments", @class = "form-control drop-dwn goverments", placeholder = @Resource.Afia.DetailAfiaRES.city })

                            </div>
                            <div class="col-md-4">
                                @Html.DropDownListFor(m => m.RegionId, new List<SelectListItem>(), new { @Id = "Region", @class = "form-control drop-dwn Region", placeholder = @Resource.Afia.DetailAfiaRES.city })

                            </div>
                            <div class="col-md-4">
                                @Html.TextBoxFor(m => m.Address, new { @class = "form-control drop-dwn", placeholder = @Resource.Afia.DetailAfiaRES.Address })


                            </div>


                            <div class="col-md-12">

                                <button type="submit" class="searchBtn btn">@LayoutRES.search</button>
                            </div>
                        </form>


                    }


                </div>
            </div>
            <div class="card-selection">
                <div class="row SearchAfiaCards">

                </div>

            </div>
        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4" crossorigin="anonymous"></script>
<script src="~/Scripts/AfiaScripts/AfiaCard/AfiaCard.js"></script>
<script>
    $(document).ready(function () {

                        getMasterCode();
                        search();
        getgoverments();
        getsubspecialty();
                    });
</script>
