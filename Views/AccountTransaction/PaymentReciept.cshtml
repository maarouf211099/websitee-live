@using Resource
@using DTO
@model AccountTransactionDTO
@{
    ViewBag.Title = AccountTransactionRES.PaymentRecieptitle;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var urlGrid = Url.Action("confirmation") + "?ispayment=true";
}
<script>
    var AccountDRPPlacholder = '@AccountTransactionRES.AccountDRPPlacholder';
    var AccountRES = '@AccountTransactionRES.For';
    var valueRES = '@AccountTransactionRES.value';
    var poundsRES = '@AccountTransactionRES.pounds';
    var newCode = "";
    var codeRes = '@AccountTransactionRES.codeRes'
</script>
<head>
<title>@AccountTransactionRES.PaymentRecieptitle</title>
</head>
<div class="modal-dialog" style="border: 3px solid #d2d6de !important;" hidden  id="PrintDIV"  dir="rtl">
    <!-- Modal content-->
    <div class="modal-body"  style="border: 3px solid #d2d6de !important;float:right !important;direction:rtl !important;width:100%;">
        <div class="box box-info"  style="">
            <div class="box-header">
                <img class=""  style="position:fixed;top:10px;left:25px; width:200px;height:100px;" src="~/images/mersalLogo.png" />

                <h2  class="" style="position:relative;top:10px;right:25px; width:50%!important;" >@ViewBag.Title</h2>
            </div><!-- /.box-header -->
            <!-- form start -->
            <div class="box-body">
                <!-- general form elements -->
                <div  style="float:right !important;direction:rtl !important;">
                    <div class="row">
                        <br />
                        <div class="col-md-4">
                            <div class="form-group">
                                <label id="codeTXT" style="margin-right:25px!important; color:#337ab7;font-size: 23px;"></label>

                            </div>
                        </div>
                        <br />

                        <div class="col-md-4">
                            <div class="form-group">
                                <label id="AccountTXT" style="margin-right:25px!important; color:#337ab7;font-size: 23px;"></label>

                            </div>
                        </div>
                        <br />

                        <div class="col-md-4">
                            <div class="form-group">
                                <label id="ValueTXT" style="margin-right:25px!important;color:#337ab7;font-size: 23px;"></label>

                            </div>
                        </div>
                    </div>
                    <br />
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label  style="margin-right:25px!important;color:#337ab7;font-size: 23px;">@AccountTransactionRES.describtion  :-</label>
                                <br />
                                <label id="DescibtionTXT" style="margin-right:50px!important;color:#337ab7;font-size: 18px;"></label>

                            </div>
                        </div>
                        </div>
                    </div>
            </div>
        </div>
    </div>
</div>
<div class="box box-info">
  <!-- /.box-header -->
    <!-- form start -->
    <div class="box-body">


        <!-- general form elements -->

            <!-- form start -->
            <form role="form" id="CreatePaymentReciept">
                <div class="box-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group ">
                                @Html.Label(AccountTransactionRES.Account)
                                <input type="text" id="AccountDRP" style="width:100%;" class="form-control" />
                                <span id="AccountDRPMSG" hidden class="field-validation-error"><span >@AccountTransactionRES.AccountRequired </span></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group ">
                                @Html.Label(AccountTransactionRES.RecieptCode)
                                <input type="text" id="RecieptCodeDRP" style="width:100%;" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                @Html.LabelFor(m => m.value)
                                @Html.TextBoxFor(m => m.value, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.value)
                            </div>
                        </div>
                        </div>
                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group">
                                @Html.LabelFor(m => m.describtion)
                                @Html.TextAreaFor(m => m.describtion, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.describtion)
                            </div>
                        </div>
                    </div>
                </div>
                <div class="box-footer" style="float:left;">


                    <button type="button" onclick="CreatePaymentReciept()" class="btn btn-primary">@AccountTransactionRES.SavePrint</button>
                    @*<a href="@urlGrid" class="btn btn-default">@AccountTransactionRES.Return</a>*@
                    <a href="@urlGrid" class="btn btn-info">@AccountTransactionRES.Return</a>
                </div>
                </form>
    </div>
    </div>
<script src="~/Scripts/MersalScripts/AccounTransaction/PaymentReciept.js"></script>
<script type="text/javascript">

    function PrintElem(elem)
    {
        Popup($(elem).html());
    }

    function Popup(data)
    {
        var mywindow = window.open('', '', '');
        mywindow.document.write('<html><head><title></title>');
        /*optional stylesheet*/ //mywindow.document.write('<link rel="stylesheet" href="main.css" type="text/css" />');
        mywindow.document.write('</head><body >');
        mywindow.document.write(data);
        mywindow.document.write('</body></html>');

        mywindow.document.close(); // necessary for IE >= 10
        mywindow.focus(); // necessary for IE >= 10

        mywindow.print();
        mywindow.close();

        return true;
    }

</script>
<script>
    GetCode()
    function Print() {
        $("#AccountTXT").html(AccountRES + " / " + $("#AccountDRP").data("kendoComboBox").text())
        $("#ValueTXT").html(valueRES + " / " + $("#value").val() + "  " + poundsRES)
        $("#DescibtionTXT").html($("#describtion").val())
        $("#codeTXT").html(codeRes + " / " + newCode)
        PrintElem("#PrintDIV")
    }
    function CreatePaymentReciept() {
        $("#AccountDRPMSG").hide();
        var myForm = $("#CreatePaymentReciept");
        var accountId = $("#AccountDRP").val()
        if (accountId == "") {
            $("#AccountDRPMSG").show();
          
        }
        if (!myForm.valid() || accountId=="") return;
        Print()
        //var DTO = {
        //    AccountId: accountId,
        //    value: ($("#value").val() ),
        //    describtion: $("#describtion").val(),
        //}
        var DTO = {
            AccountId: accountId,
            EmployeeId: null,
            Value: ($("#value").val() ),
            Details: $("#describtion").val(),
            ISCustody: false,
            IsConfirm: false,
            Code: newCode,
            IsPayment: true,
            TransactionId: $("#RecieptCodeDRP").val()
        }
        var apiurl = MersalWebAPIBaseUrl + "api/CashCustodyConfirmation/Create";
        $.ajax({
            type: "POST",
            contentType: "application/json",
            url: apiurl,
            crossDomain: true,
            headers: getHeaders(),
            data: JSON.stringify(DTO),
            async: false,
            success: function (data) {

                if (data > 0) {
                  

                    toastr.success(SuccessfullyAdd + " - " + data);
                    document.getElementById("CreatePaymentReciept").reset();
                  
                   
                }
                else {
                    toastr.error(Error);
                } 
            },
            error: function (xhr) {
                HideAnyModal();
                toastr.error(xhr.error); 
            }
        });
    }
  
    function GetCode() {
        
        var apiurl = MersalWebAPIBaseUrl + "api/CashCustodyConfirmation/getCode";
        $.ajax({
            type: "get",
            contentType: "application/json",
            url: apiurl,
            crossDomain: true,
            headers: getHeaders(),

            async: false,
            success: function (data) {
                
                newCode = data;

            },
            error: function (xhr) {

            }
        });
    }
</script>
                             