@using Resource
@using DTO
@model AccountTransactionDTO
@{
    ViewBag.Title = AccountTransactionRES.AddTransaction;
    Layout = "";
}

@Scripts.Render("~/bundles/jqueryval")

<div class="modal-dialog" >
    <!-- Modal content-->
    <div class="modal-body">
        <div class="box box-info">
            <div class="box-header with-border">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                @*<h4 class="modal-title">Case Comment - @Html.DisplayFor(m => m.CaseName)</h4>*@
                <h4 class="modal-title">@ViewBag.Title</h4>

              

            </div><!-- /.box-header -->
            <!-- form start -->
            <div class="box-body">


                <!-- general form elements -->
                <div class="box box-primary">

                    <!-- form start -->
                    <form role="form" id="CreateAccountTransActionForm">
                        <div class="box-body">

                            <div class="row">
                                
                                <div class="col-md-5">
                                    <br />
                                    <div class="form-group ">
                                        <div class="col-md-6"><input type="radio" name="transActionType" value="credit" checked> @AccountTransactionRES.Credit</div>
                                        <div class="col-md-6"><input type="radio" name="transActionType" value="debit"> @AccountTransactionRES.Debit</div>
                                      
                                       
                                      
                                    </div>
                                
                                </div>
                                <div class="col-md-5">
                                    <div class="form-group">
                                        @Html.LabelFor(m => m.value)
                                        @Html.TextBoxFor(m => m.value, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.value)
                                    </div>
                                </div>
                                <div class="col-md-10">
                                    <div class="form-group">
                                        @Html.LabelFor(m => m.describtion)
                                        @Html.TextAreaFor(m => m.describtion, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.describtion)
                                    </div>
                                </div>
                                </div>
                            </div>
                        <div class="box-footer" style="float:left;">
                            
                           
                                <button type="button" onclick="CreateAccountTransaction()" class="btn btn-primary">@AccountRES.Save</button>
                            
                        </div>
                        </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function CreateAccountTransaction() {
        var myForm = $("#CreateAccountTransActionForm");
        var type=1;
        if (!myForm.valid()) return;
        if ($("input[name=transActionType]:checked").val() == "debit") {
            type=-1;
        }
        var DTO = {
            AccountId:transactionAccountId,
            value: ($("#value").val()*type),
            describtion: $("#describtion").val(),
        }
        var apiurl = MersalWebAPIBaseUrl + "api/AccountTransaction/CreateTransaction";
        $.ajax({
            type: "POST",
            contentType: "application/json",
            url: apiurl,
            crossDomain: true,
            headers: getHeaders(),
            data: JSON.stringify(DTO),
            async: false,
            success: function (data) {

                if (data > 0) {
                    GetAndDrawAccountTree()

                    toastr.success(SuccessfullyAdd + " - " + data);
                    document.getElementById("CreateAccountTransActionForm").reset();
                    transactionAccountId = 0;
                    HideAnyModal();
                }
                else {
                    toastr.error(Error);
                } 
            },
            error: function (xhr) {
                HideAnyModal();
                toastr.error(xhr.error); 
            }
        });
    }
</script>
