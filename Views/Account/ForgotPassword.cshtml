


@model UserUI.Controllers.ForgotPasswordViewModel
@using Resource
@{
    ViewBag.Title =  LayoutRES.ForgotPassword;
}
<section> 
    <div class="block gray">
        <div class="container">
            <div class="search-page"> 
                <div class="col-md-9 column">
                    <h5>@LayoutRES.ForgotyourPassword</h5>
                    @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { @class = "contact-form", role = "form", id = "forgotPasswordForm" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="row"> 
                            <div class="col-md-10">@Html.TextBoxFor(m => m.Email, new { placeholder = LayoutRES.Email })</div>
                            @Html.ValidationMessageFor(m => m.Email)
                            <div class="col-md-2">
                                <a class="theme-btn" href="javascript:{}" onclick="document.getElementById('forgotPasswordForm').submit();">@LayoutRES.Submit</a>
                            </div>  
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
 