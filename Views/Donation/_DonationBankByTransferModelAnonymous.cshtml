            success: function (data) {
                var html = "";
                if (enableAll) {
                    if (_cultureIsArabic) {
                        html = "<option value='0'>الكل</option>";
                    }
                    else {
                        html = "<option value='0'>All</option>";
                    }
                }
                if (false) {

                }
                else {
                    $.each(data, function (key, value) {
                        var selec = "";
                        if (true) {
                            //if (true) selec = " selected='selected' ";
                            if (_cultureIsArabic) {
                                html += "<option Code=" + value.NameAr + " value=" + value.Id + selec + "  >" + value.NameAr + "</option>";
                            }
                            else {
                                html += "<option Code=" + value.NameEn + " value=" + value.Id + selec + " >" + value.NameEn + "</option>";
                            }
                        }
                    });
                }
                $("#" + dropDownListId).html(html);
                if (emptyOption) {
                    $("#" + dropDownListId).prepend("<option value='' selected='selected'>" + placeholder+'*'+"</option>");
                }
