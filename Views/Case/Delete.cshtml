@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")


<script>
    $(document).ready(function () {
        //submit
        var myForm = $("#DeleteForm");
        myForm.submit(function (e) {
            e.preventDefault(); 
            var apiurl = MersalWebAPIBaseUrl + "api/Case/DeleteCase"; 
            var data = { Id: $("#Id").val() }; 
            $.ajax({
                type: "POST",
                contentType: "application/json",
                url: apiurl,
                crossDomain: true,
                headers: getHeaders(),
                data: JSON.stringify(data),
                async: false,
                success: function (data) { 
                    toastr.success("Successfully" + data);
                },
                error: function (xhr) { 
                    toastr.error(xhr.statusText);
                }
            });
        });
    });


</script>
