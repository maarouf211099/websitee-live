@model DTO.CaseFamilyBudgetDTO
@using Resource
@using UserUI.Helper
@{
    bool isArabic = UserUI.Helper.CultureHelper.GetCurrentCulture() == "ar-SA";
    var floatToRight = (CultureHelper.IsRighToLeft() ? "floatToRight" : "");
    var textAlignRight = isArabic ? "text-align: right;" : "";
    var dir = isArabic ? "rtl" : "ltr";
}


<div class="modal fade" id="EditCaseBudgetModal" role="dialog" dir="@dir">
    <div class="modal-dialog" style="width: 900px;">
        <!-- Modal content-->
        <div class="modal-body">
            <div class="box box-info">
                <div class="box-header with-border">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">@LayoutRES.Edit</h4>
                </div>

                @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form-horizontal", id = "EditCaseBudgetForm" }))
                {
                    @Html.HiddenFor(x=>x.Id)
                    @Html.HiddenFor(x => x.CaseId)
                    <div class="box-body">
                        <div class="form-horizontal">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.TextBoxFor(model => model.Title, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Title)
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Amount, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.TextBoxFor(model => model.Amount, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Amount)
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-md-6">
                                    <input type="radio" name="IsIncome" id="IsIncome" value="true" checked />
                                    <label>@CaseResources.Income</label>
                                </div>
                                <div class="col-md-6">
                                    <input type="radio" name="IsIncome" id="IsIncome" value="false" />
                                    <label>@CaseResources.OutCome</label>
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Currency, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    <input type="hidden" value="@Model.Currency" id="CurrencyValueId"/>
                                    @Html.DropDownListFor(x => x.Currency, new List<SelectListItem>(), new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Currency)
                                </div>
                            </div>
                        </div>

                        <div class="box-footer">
                            <button type="submit" class="btn btn-info pull-right">@LayoutRES.SubmitEdit</button>
                            <button type="button" class="btn btn-default pull-left" data-dismiss="modal">@LayoutRES.Close</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

