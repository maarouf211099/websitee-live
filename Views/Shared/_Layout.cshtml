        // Check if the media query matches
        if (mediaQuery.matches) {
            setTimeout(() => {
                // Get a reference to the #tiledeskdiv element
                const tiledeskdiv = document.querySelector('#tiledeskdiv');

                // Add !important to the end of the inline style value
                tiledeskdiv.style.setProperty('right', 'unset', 'important');
            }, 2000);
        }

