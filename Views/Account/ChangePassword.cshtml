@model  Components.UserManagement.DTO.ManagePasswordUserViewModel
@using Resource

@{
    ViewBag.Title = LayoutRES.ChangePassword;
} 
 
<section>
    <div class="block gray">
        <div class="container">
            <div class="search-page">
                <div class="col-md-9 column">
                    <h5>@LayoutRES.ChangePassword</h5>
                    @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post, new { @class = "contact-form", role = "form", id = "ChangePasswordForm" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="row">
                            <div class="form-group">
                                <div class="col-md-10">
                                    @Html.PasswordFor(model => model.OldPassword, new { placeholder = LayoutRES.OldPassword })
                                    @Html.ValidationMessageFor(m => m.OldPassword)
                                </div>
                            </div> 
                            <div class="form-group">
                                <div class="col-md-10">
                                    @Html.PasswordFor(m => m.NewPassword, new { placeholder = LayoutRES.NewPassword })
                                    @Html.ValidationMessageFor(m => m.NewPassword)
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-md-10"> 
                                    @Html.PasswordFor(m => m.ConfirmPassword, new { placeholder = LayoutRES.ConfirmPassword })
                                    @Html.ValidationMessageFor(m => m.ConfirmPassword)
                                </div>
                            </div>
                            <div class="col-md-5">
                                <input id="btnSubmit" type="submit" value="@LayoutRES.Submit"   style="display:none;"/>
                                @*<a class="theme-btn" href="javascript:{}" onclick="document.getElementById('ChangePasswordForm').submit();">@LayoutRES.Submit</a>*@
                                <a class="theme-btn" href="javascript:{}" onclick="$('#btnSubmit').click();">@LayoutRES.Submit</a>
                            </div>
                        </div>
                    }
                            </div>
                        </div>
        </div>
    </div>
</section>


