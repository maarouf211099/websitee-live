


@using Resource 
<div class="modal fade" id="cofirmationMessageModals" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-body">
            <div class="box box-info">
                <div class="box-header with-border">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 id="ConfirmationMassageHeader"></h4>
                </div><!-- /.box-header -->
                <!-- form start -->
                <div class="box-body">
                    <div>
                        <h3 id="ConfirmationMassageH3"></h3>
                    </div>
                    <div class="box-footer"> 
                        <button type="button" id="btnsubmitConfirmationDialog" class="btn btn-info pull-right" onclick="btnsubmitConfirmationDialog();">@LayoutRES.Submit</button>
                         <button type="button"  class="btn btn-default pull-left" data-dismiss="modal">@LayoutRES.Close</button>
                    </div><!-- /.box-footer -->
                </div>
            </div>
        </div>
    </div>
</div>
