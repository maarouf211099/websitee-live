        }
        $('#BankId').val(model.BankId);
        GetAccountBankByParentId('DonationAccountId', model.BankId, 'hide', '@DonationResources.BankAccount');

      },
      error: function (xhr) {
        toastr.error(xhr.statusText);
      }
    });
  }

  function GetAccountBankByParentId(dropDownId, parentId, itemToShow, placeholder) {

    $.ajax({
      type: "GET",
      contentType: "application/json",
      url: MersalWebAPIBaseUrl + "api/DonationBanks/GetAllDonationAccountByBankId?bankId=" + parentId,
      async: true,
      success: function (data) {
        var htmlGovernorate = "<option value=''>" + placeholder + '*' + "</option>";
        $.each(data, function (key, value) {
          htmlGovernorate += "<option value=" + value.Id + " >" + value.AccountNumber + "</option>";
        });
        $("#" + dropDownId).html(htmlGovernorate);
        if (data.length != 0) {
          $('#' + itemToShow).show();

        }
        if (model.DonationAccountId != null && itemToShow == 'hide') {
          $('#DonationAccountId').val(model.DonationAccountId);
          GetAllDonationCurencyByAccountId('DonationCurrencyId', model.DonationAccountId, 'hide', '@DonationResources.Currency');

        } else {
          GetAllDonationCurencyByAccountId('DonationCurrencyId', model.DonationAccountId, 'DonationCurrencyId', '@DonationResources.Currency');
        }

      },
      error: function (xhr) {
        //toastr.error(xhr.statusText);
      }
    });

  }

  function GetAllDonationCurencyByAccountId(dropDownId, parentId, itemToShow, placeholder) {
    $.ajax({
      type: "GET",
      contentType: "application/json",
      url: MersalWebAPIBaseUrl + "api/DonationBanks/GetCurenciesByAccountId?donationAccountId=" + parentId,
      async: true,
        success: function (data) {
        currancyList = data;
        var htmlGovernorate = "<option value=''>" + placeholder + '*' + "</option>";
        $.each(data, function (key, value) {
          htmlGovernorate += "<option value=" + value.Id + " >" + value.NameAr + "</option>";
        });
        $("#" + dropDownId).html(htmlGovernorate);
        if (data.length != 0) {
            $('#' + itemToShow).show();            
          //$("#" + dropDownId).rules("add", {
          //    required: false,
          //    messages: {
          //        required: requiredDonationDestination
          //    }
          //});

          }
        if (model.DonationCurrencyId != null && itemToShow == 'hide') {
            $('#DonationCurrencyId').val(model.DonationCurrencyId);
            var selected = currancyList.find(({ Id }) => Id == $('#DonationCurrencyId').val());
            if (selected.NameEn.trim() != 'EGP') {
                $('#BBFCYRate').show();
            } else {
                $('#BBFCYRate').hide();
            }
        }

      },
      error: function (xhr) {
        //toastr.error(xhr.statusText);
      }
    });

  }




