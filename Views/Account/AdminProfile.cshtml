@model  Components.UserManagement.DTO.UserDetailsDTO
@using UserUI.Helper
@using Kendo.Mvc.UI
@using Notification.DTO
@using Resource
@using Components.UserManagement.Resources
@{
    ViewBag.Title = LayoutRES.Profile;
    List<SelectListItem> emptyList = new List<SelectListItem>();
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    bool isArabic = UserUI.Helper.CultureHelper.GetCurrentCulture() == "ar-SA";
    var floatToRight = (CultureHelper.IsRighToLeft() ? "floatToRight" : "");
    var textAlignRight = isArabic ? "text-align: right;" : "";
    var dir = isArabic ? "rtl" : "ltr";
    var tblTextAlign = isArabic ? "tblText" : "";
}
<head>
    <title>@LayoutRES.Profile</title>
</head>
<div id="AssignTaskToEmployeeDiv"></div>

<div>
    @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "editUserManagementForm" }))
