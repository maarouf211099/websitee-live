      async: async,
      success: function (data) {
        var html = "";
        if (enableAll) {
          if (_cultureIsArabic) {
            html = "<option value='0'>الكل</option>";
          }
          else {
            html = "<option value='0'>All</option>";
          }
        }
        if (false) {

        }
        else {
          $.each(data, function (key, value) {
            var selec = "";
            if (true) {
              if (true) selec = " selected='selected' ";
              if (_cultureIsArabic) {
                html += "<option Code=" + value.Name + " value=" + value.Id + selec + "  >" + value.Name + "</option>";
              }
              else {
