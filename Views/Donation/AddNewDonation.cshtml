    function DeleteReceptionDonation(id) {
        var CallBackFunction = function () { ConfirmDeleteReceptionDonation(id); };
        confirmMessageBootstrap(ConfirmDelete, sureDelete, 400, 250, CallBackFunction);
    }

    function ConfirmDeleteReceptionDonation(id) {
        var url = MersalWebAPIBaseUrl + "api/Donation/DeleteReceptionDonation?id=" + id
        $.ajax({
            type: "POST",
            contentType: "application/json",
            headers: getHeaders(),
            url: url,
            async: false,
            success: function (data) {
                toastr.success(SuccessfulProcess);
                $("#grid").data("kendoGrid").dataSource.read();
                $("#grid").data("kendoGrid").refresh();
            },
            error: function (xhr) {
                toastr.error(xhr.statusText);
            }
        });
    }

    $(document).ready(function () {

        $("input#Date").datepicker().datepicker("setDate", new Date());

        $('#CaseId').change(function () {
            $('#CaseIdMsg').addClass('hidden');
        });

        $('#Date').change(function () {
            $('#DateMsg').addClass('hidden');
            $(this).datepicker("setDate", $(this).datepicker('getDate'));
        });

        $('form').submit(function () {
            var ifAllValid = true;


            if ($("#CaseId").val() === '') {
                $('#CaseIdMsg').removeClass('hidden');
                ifAllValid = false;
            }

            if ($('#TransitionSource').val() === '') {
                ifAllValid = false;
            }

            if ($('#ReceiptNo').val() === '') {
                ifAllValid = false;
            }

            if ($('#value').val() === '') {
                ifAllValid = false;
            }

            if ($("#Date").datepicker('getDate') === null) {
                $('#DateMsg span').html(dateIsRequiredPlaceHolder);
                $('#DateMsg').removeClass('hidden');
                ifAllValid = false;
            } else {
                var date_regex = /^([1-9]|1[0-2])\/([1-9]|1\d|2\d|3[01])\/(19|20)\d{2}$/;
                var date = ($("#Date").datepicker('getDate').getMonth() + 1) + '/' + $("#Date").datepicker('getDate').getDate() + '/' + $("#Date").datepicker('getDate').getFullYear();
                if (!(date_regex.test(date))) {
                    $('#DateMsg span').html(dateIsInvalidPlaceHolder);
                    $('#DateMsg').removeClass('hidden');
                    ifAllValid = false;
                }
            }

            if (ifAllValid) {
                if ($('form').valid()) {
                    CreateDonation();
                }
            }
            return false
        });
    });

    function CreateDonation() {
        var apiurl = MersalWebAPIBaseUrl + "api/AccountTransaction/AddNewDonation";
        var date = $("#Date").datepicker('getDate').getDate() + '/' + ($("#Date").datepicker('getDate').getMonth() + 1) + '/' + $("#Date").datepicker('getDate').getFullYear();
        var DTO = {
            CaseId: $("#CaseId").val(),
            AccountId: 0,
            value: $("#value").val(),
            describtion: '',
            CreateBy: getHeaders()["Id"],
            Date: date,
            TransitionSource: $('#TransitionSource').val(),
            ReceiptNo: $('#ReceiptNo').val()
        };

        $.ajax({
            type: "POST",
            contentType: "application/json",
            url: apiurl,
            crossDomain: true,
            headers: getHeaders(),
            data: JSON.stringify(DTO),
            async: false,
            success: function (data) {
                if (data === '') {
                    toastr.success(SuccessfulProcess);
                    document.getElementById("AddNewDonationForm").reset();
                    $("#CaseId").kendoComboBox({
                        placeholder: chooseTheCasePlaceHolder,
                        dataTextField: "Name",
                        dataValueField: "Id",
                        filter: "contains",
                        dataSource: {
                            transport: {
                                read: {
                                    url: MersalWebAPIBaseUrl + "api/Case/GetCasesNamesIds",
                                    headers: getHeaders()
                                }
                            }
                        }
       ,
                        filter: "contains",
                        suggest: true,
                    });
                    $("#grid").data("kendoGrid").dataSource.read();
                    $("#grid").data("kendoGrid").refresh();

                    location.reload(true);

                }
                else {
                    toastr.error(data);
                }
            },
            error: function (xhr) {
                toastr.error(xhr.error);
                console.log(xhr);
            }
        });

    }



