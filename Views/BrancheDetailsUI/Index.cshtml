
@model  IEnumerable<BrancheDetailsDTO>
@using UserUI.Helper
@using Resource
@using DTO
@{
    ViewBag.Title = LayoutRES.Branches;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    bool isArabic = UserUI.Helper.CultureHelper.GetCurrentCulture() == "ar-SA";
    var floatToRight = (CultureHelper.IsRighToLeft() ? "floatToRight" : "");
    var textAlignRight = isArabic ? "text-align: right;" : "";
    var dir = isArabic ? "rtl" : "ltr";
    var tblTextAlign = isArabic ? "tblText" : "";
}
<style>
    .tblText tr {
        text-align: right;
    }

    .tblText th {
        text-align: right;
    } 
        #map {
        height: 450px;
        width : 100%; 
    }
</style>
<div class="form-group">
    <button onclick="getCreateBranche()" type="button" class="btn btn-info">@LayoutRES.CreateBranche</button>
</div>

<div class="row">
    <div class="col-xs-12">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">@LayoutRES.Branches </h3>
            </div>
            <div class="box-body table-responsive no-padding">
                <table class="table table-hover">
                    <tbody class="@tblTextAlign">
                        <tr>
                            <th>@LayoutRES.BranchNameEN</th>
                            <th>@LayoutRES.BranchNameAR</th>
                            <th>@LayoutRES.AddressEN</th>
                            <th>@LayoutRES.AddressAR</th>
                            <th>@LayoutRES.Tel</th>
                            <th>@LayoutRES.Email</th> 
                            <th>@LayoutRES.Delete </th>
                        </tr>
                        @foreach (var branc in Model)
                        {
                            <tr branchId ="@branc.Id">
                                <td>@branc.NameEN</td>
                                <td>@branc.NameAR</td>
                                <td>@branc.AddressEN</td>
                                <td>@branc.AddressAR</td>
                                <td>@branc.Tel</td>
                                <td>@branc.EMail</td> 
                                <th><span class="label label-danger" style="cursor: pointer;" onclick="DeleteBranche('@branc.Id')">@LayoutRES.Delete </span> </th>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@Html.Partial("~/Views/BrancheDetailsUI/_CreateBranche.cshtml", new BrancheDetailsDTO())


<div id="EditBranche">

</div>

@section Scripts { 
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyD2l5oes21pBsgScCGl6WFrklamZYtRX54"></script>
    <script src="~/Scripts/MersalScripts/LayoutManagment/AdminBranches.js"></script>
  @*  @Scripts.Render("~/bundles/AdminBranches")*@
}

  



