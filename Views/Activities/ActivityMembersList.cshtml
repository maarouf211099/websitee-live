<div class="@(CultureHelper.IsRighToLeft() ? "k-rtl" : "")">
    @(Html.Kendo().Grid((List<ActivityMembersListDTO>)Model)
              .Name("Grid")
              .Pageable(pager => pager.Refresh(true))
              .Sortable().Groupable(g => g.Messages(m => m.Empty(LayoutRES.DragaColumnHeaderAndDropItHereToGroupByThatColumn)))
              .Columns(columns =>
              {
                  columns.Bound(e => e.ActivityId).Title(ActivitiesRES.ActivityId);
                  columns.Bound(e => e.ActivityName).Title(ActivitiesRES.ActivityName);
                  columns.Bound(e => e.UserId).Title(ActivitiesRES.UserId);
                  columns.Bound(e => e.MemberName).Title(ActivitiesRES.MemberName);
                  columns.Bound(e => e.MemberPhoneNumber).Title(ActivitiesRES.MemberPhoneNumber);
                  columns.Bound(e => e.MemberEmail).Title(ActivitiesRES.MemberEmail);
                  columns.Bound(e => e.ValueAmount).Title(ActivitiesRES.ValueAmount);
              })
              .DataSource(dataSource => dataSource.Ajax().PageSize(10).Read(read => read.Url(string.Format("{0}api/Activities/ActivityMembersList?Id={1}", ConfigurationManager.AppSettings["MersalWebAPIBaseUrl"], ViewBag.ActId)).Type(HttpVerbs.Get)))

    )
</div>


@section Scripts {
    <script src="~/Scripts/MersalScripts/Activity/SpecificActivityScript.js"></script>
}
