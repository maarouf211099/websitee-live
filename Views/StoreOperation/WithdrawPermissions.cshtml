<script id="confirm withdraw permission"> 
        function ConfirmWithdrawPermission(Id) {

            var _url = '@ConfigurationManager.AppSettings["MersalWebAPIBaseUrl"]' + 'api/StoreOperations/ConfirmWithdrawPermission?withdrawTransactionId=' + Id;

            $.ajax({
                type: "Get",
                async: false,
                contentType: "application/json",
                url: _url,
                success: function (data) {
                    if (data > 0) {
                        toastr.success('@InventoryItemsRes.OperationSucceeded');
                        RefreshWithdrawPermissions();
                    }
                    else {
                        toastr.error('@InventoryItemsRes.OperationFailed');
                    }
                },
                error: function (xhr) {
                    toastr.error('@InventoryItemsRes.OperationFailed');
                }
            });
        } 
   
</script>
<script id="Kendo Grid Confirm Withdraw">
 
    function getConfirmTemplate(id,isConfirmed, quantity, availableQuantity) {
        if (isConfirmed) {
            return '<label>@StoreOperationsRes.AlreadConfirmed</label>'
        }
        else {
            if (quantity <= availableQuantity) {
                return "<a onClick='ConfirmWithdrawPermission(" + id + ")' >@StoreOperationsRes.Confirm</a>";
            }
            else {
                return "<a style='color: red'>@StoreOperationsRes.CanNotBeConfirmed</a>";
            }
        }

    }

</script>